---
import { getCollection, getEntry } from 'astro:content';
import SanityImage from './SanityImage.astro';
import { PortableText } from 'astro-portabletext';

import SanityPortableImage from './SanityPortableImage.astro';
import SanityHighlight from './SanityHighlight.astro';
import { getCurriculumDuration } from '../lib/utils/getCurriculumDuration';
import { getTotalUnits } from '../lib/utils/getTotalUnits';
import { urlFor } from '@/lib/sanity/image';

const components = {
  type: {
    image: SanityPortableImage,
  },
  mark: {
    highlight: SanityHighlight,
  },
};

const programs = (await getCollection('programs')).sort().reverse();

// Pre-fetch curriculum + logo for each program (parallel)
const programData = await Promise.all(
  programs.map(async (p) => ({
    program: p,
    curriculum: await getEntry('curriculum', p.id),
    logo: p.data.logo ? urlFor(p.data.logo).width(128).height(128).url() : '/images/asiatech_logo.avif',
  })),
);

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id='program-section' class='relative w-full overflow-hidden bg-background py-24 md:py-32'>
  <!-- Top meta bar -->
  <div class='pointer-events-none absolute inset-0 opacity-[1] pattern-graph'></div>
  <div
    class='relative z-10 mx-auto mb-12 flex w-full max-w-[1600px] items-center gap-4 px-6 md:px-10 text-[10px] md:text-xs tracking-[0.25em] text-stone-500'>
    <span class='flex items-center gap-2'>
      <span class='relative inline-block size-1.5 rounded-full bg-accent'>
        <span class='absolute inset-0 animate-ping rounded-full bg-accent/70'></span>
      </span>
      <span class='uppercase'>Programs Offered</span>
    </span>
    <span class='h-px flex-1 bg-linear-to-r from-stone-700/80 via-stone-700/30 to-transparent'></span>
    <span class='uppercase'>CEITE</span>
  </div>

  <!-- Headline -->
  <header class='relative z-10 mx-auto max-w-4xl px-6 text-center'>
    <h1 class='font-(family-name:--font-tiktok) text-5xl leading-[0.95] sm:text-6xl md:text-7xl lg:text-8xl'>
      <span class='block text-stone-50'>C.E.I.T.E.</span>
      <span class='block text-accent'>Programs</span>
    </h1>

    <div class='relative mt-6 flex items-center justify-center text-[11px] tracking-[0.25em] text-stone-400'>
      <div class='flex items-center gap-10'>
        <p class='mx-auto mt-5 max-w-xl text-sm leading-relaxed tracking-wider text-stone-400 sm:text-base'>
          Choose your path in the tech landscape
        </p>
      </div>
    </div>
    <span class='w-full block h-px m-8 bg-linear-to-r from-transparent via-accent/50 to-transparent'></span>
    <strong class='font-bold text-stone-100'>Bachelor</strong>
    and
    <strong class='font-bold text-stone-100'>Associate</strong>
  </header>

  <!-- Pagination -->
  <div
    id='swiper-program-pagination'
    class='relative z-10 mx-auto mt-8 mb-0 sm:mb-6 w-full max-w-[1600px] px-6 md:px-10 select-none'>
    <div class='swiper-pagination !static !flex flex-wrap items-center justify-center gap-4 sm:gap-6'></div>
  </div>

  <!-- Slider -->
  <div
    id='swiper-program'
    class='swiper relative mb-12 w-full max-w-[1920px] h-[600px] md:h-[clamp(640px,780px,85vh)] !px-4 !py-4 sm:!px-0'>
    <div class='swiper-wrapper w-full h-full'>
      {
        programData.map(({ program: p, curriculum, logo }, i) => (
          <div class='swiper-slide group select-none' data-logo={logo} data-title={p.data.title}>
            <div class='img-wrapper'>
              <SanityImage image={p.data.image} Xparallax={30} loading='lazy' width={1920} height={1080} />
              {/* Gradient layers */}
              <div class='gradient-layer absolute inset-0 bg-background/83 sm:bg-background/0 sm:bg-linear-to-t from-background/75 via-background/40 via-30% to-transparent' />
              <div class='gradient-layer absolute inset-0  sm:bg-linear-to-r from-background/85 from-15% via-background/50 via-45% to-transparent' />
            </div>

            {/* Content */}
            <div class='absolute inset-0 flex flex-col px-6 py-6 sm:px-10 sm:pt-2 pb-12 sm:pb-16 md:px-14 md:pt-4 md:pb-24'>
              {/* Top row: program counter + logo */}
              <div class='flex items-center justify-between gap-4'>
                <div class='flex items-center text-[8px] gap-2 rounded-full border border-accent/50 bg-stone-900/60 px-4 py-1.5'>
                  <span class='tracking-[0.3em] uppercase text-accent '>Program</span>
                  <span class='text-accent/50'>·</span>
                  <span class='font-bold tabular-nums text-accent'>{pad(i + 1)}</span>
                  <span class='text-accent/50'>/</span>
                  <span class='tabular-nums text-accent/50'>{pad(programs.length)}</span>
                </div>

                <SanityImage
                  class='size-16 sm:size-20 md:size-24 rounded-full border border-stone-400/30 bg-stone-900/60 p-2.5'
                  image={p.data.logo}
                  fallback='/images/asiatech_logo.avif'
                  format='none'
                  width={128}
                  height={128}
                />
              </div>

              {/* Title */}
              <div class='flex flex-1 flex-col justify-start' data-swiper-parallax='-75'>
                <h2 class='font-(family-name:--font-tiktok) leading-none tracking-wider text-stone-50 text-4xl sm:text-[clamp(55px,10vh,96px)] drop-shadow-[0_4px_30px_rgba(0,0,0,0.6)]'>
                  {p.data.title}
                </h2>

                <h3 class='mb-2 font-medium text-stone-300 text-xs sm:text-[clamp(16px,10vh,20px)]'>
                  {p.data.titleLong}
                </h3>
              </div>

              {/* Stats */}
              <div class='flex flex-col gap-8' data-swiper-parallax='-25'>
                <div class='flex flex-col gap-6'>
                  <div class='flex items-end gap-8 sm:gap-12'>
                    <div class='flex flex-col'>
                      <span class='mb-2 text-[8px] sm:text-[10px] tracking-wider uppercase text-stone-400 font-medium'>
                        Duration
                      </span>
                      <span class='font-(family-name:--font-tiktok) text-md sm:text-3xl text-accent'>
                        {getCurriculumDuration(curriculum)}
                        <span class='ml-0.5 text-[10px] sm:text-sm font-medium tracking-wider uppercase text-stone-400'>
                          years
                        </span>
                      </span>
                    </div>
                    <div class='h-10 w-px bg-stone-700/60' />
                    <div class='flex flex-col'>
                      <span class='mb-2 text-[8px] sm:text-[10px] tracking-wider uppercase text-stone-400 font-medium'>
                        Total Units
                      </span>
                      {/* Total units — now reads from curriculum, not program */}
                      <span class='font-(family-name:--font-tiktok) text-md sm:text-3xl tabular-nums text-accent'>
                        {getTotalUnits(curriculum)}
                        <span class='ml-0.5 text-[10px] sm:text-sm font-medium tracking-wider uppercase text-stone-400'>
                          units
                        </span>
                      </span>
                    </div>
                  </div>

                  <span class='w-full block h-px m-0 bg-linear-to-r from-stone-700/67 to-transparent' />

                  <div class='flex justify-between sm:justify-start sm:gap-8'>
                    <div class='flex flex-col'>
                      <span class='mb-3 text-[8px] sm:text-[10px] tracking-wider uppercase text-stone-400'>
                        Specialization Tracks
                      </span>
                      <ul class='flex flex-wrap gap-2'>
                        {p.data.specializations?.map((s) => (
                          <li
                            class='flex items-center gap-2 rounded-full border border-[var(--program-color)]/60 bg-[var(--program-color)]/25 px-2 py-1 sm:px-3 sm:py-1.5 text-[9px] sm:text-xs font-semibold text-[var(--program-color)] transition-colors hover:bg-[var(--program-color)]/33'
                            style={`--program-color: ${s.color}`}>
                            <span class='size-1.5 shrink-0 animate-pulse brightness-125 saturate-150 rounded-full bg-[var(--program-color)] shadow-[0_0_8px_2px_rgb(from_var(--program-color)_r_g_b_/_0.5)]' />
                            <span class='tracking-wide'>{s.specialization}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <div class='flex flex-col'>
                      <span class='mb-3 text-[8px] sm:text-[10px] tracking-wider uppercase text-stone-400'>
                        Career Paths
                      </span>
                      <div class='flex flex-col career-paths text-xs sm:text-sm text-stone-300 [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-2 [&_li:nth-child(n+4)]:hidden'>
                        <PortableText value={p.data.careers} components={components} />
                        <span class='mt-2 text-accent'>+ More...</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <a
                href={`/programs/${p.data.slug}`}
                class='group/cta mt-14 shrink-0 inline-flex w-fit items-center gap-2 bg-accent px-5 py-2.5 text-sm font-semibold text-background transition-all hover:border-accent hover:bg-orange-300 hover: hover:font-black'>
                <span>Learn more</span>
                <svg
                  class='size-4 transition-transform group-hover/cta:translate-x-1'
                  viewBox='0 0 24 24'
                  fill='none'
                  stroke='currentColor'
                  stroke-width='2'>
                  <path d='M5 12h14M13 5l7 7-7 7' stroke-linecap='round' stroke-linejoin='round' />
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import Swiper from 'swiper';
  import { Pagination, Parallax, Keyboard } from 'swiper/modules';

  let swiperInstance: Swiper | null = null;

  function initSwiper() {
    const el = document.querySelector('#swiper-program');
    if (!el) return;

    if (swiperInstance) {
      swiperInstance.destroy(true, true);
      swiperInstance = null;
    }

    swiperInstance = new Swiper('#swiper-program', {
      modules: [Parallax, Pagination, Keyboard],
      grabCursor: true,
      speed: 600,
      spaceBetween: 8,
      parallax: true,
      slidesPerView: 1.2,
      centeredSlides: true,
      keyboard: { enabled: true },
      pagination: {
        el: '#swiper-program-pagination .swiper-pagination',
        clickable: true,
        renderBullet: (index, className) => {
          const slide = document.querySelector(
            `#swiper-program .swiper-slide:nth-child(${index + 1})`,
          ) as HTMLElement | null;
          const logo = slide?.dataset.logo ?? '';
          const title = slide?.dataset.title ?? '';
          return `
            <button class="${className} program-bullet" type="button" aria-label="Go to ${title}">
              <span class="program-bullet__logo-wrap">
                <img src="${logo}" alt="" class="program-bullet__logo" loading="lazy" />
              </span>
              <span class="program-bullet__title">${title}</span>
            </button>
          `;
        },
      },
      breakpoints: {
        768: { slidesPerView: 1.25, spaceBetween: 24 },
        1080: { slidesPerView: 1.33, spaceBetween: 36 },
        1440: { slidesPerView: 1.5, spaceBetween: 48 },
      },
    });
  }

  document.addEventListener('astro:page-load', initSwiper);

  document.addEventListener('astro:before-swap', () => {
    if (swiperInstance) {
      swiperInstance.destroy(true, true);
      swiperInstance = null;
    }
  });
</script>
