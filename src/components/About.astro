<section class='relative bg-neutral-950 px-6 py-20 sm:px-10 lg:px-16 lg:py-28'>
  {/* Decorative grid background */}
  <div class='pointer-events-none absolute inset-0 opacity-[0.45] pattern-circuit'></div>

  {/* Glow accent */}
  <div class='pointer-events-none absolute -top-40 right-0 h-[500px] w-[500px] rounded-full bg-accent/20 blur-[240px]'>
  </div>

  <div class='relative mx-auto max-w-7xl'>
    {/* Eyebrow */}
    <div class='mb-8 flex items-center gap-3'>
      <span class='h-px w-12 bg-accent'></span>
      <span class='text-xs font-semibold uppercase tracking-[0.3em] text-accent'> About </span>
    </div>

    {/* Headline */}
    <h1 class='text-5xl font-bold leading-[0.95] tracking-tight text-white sm:text-6xl lg:text-7xl xl:text-8xl'>
      Asiatech
      <span class='block text-accent'> C.E.I.T.E. </span>
    </h1>

    <p class='mt-6 max-w-xl text-sm uppercase tracking-[0.2em] text-white/50'>
      College of Engineering, Information Technology &amp; Education
    </p>

    {/* Main grid: video + content */}
    <div class='mt-16 grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12'>
      {/* Video */}
      <div class='lg:col-span-7'>
        <div class='group relative'>
          {/* Offset frame */}
          <div class='absolute -inset-3 rounded-2xl border border-accent/20'></div>

          <div class='relative overflow-hidden rounded-xl bg-black ring-1 ring-white/10'>
            <div class='aspect-video w-full'>
              <iframe
                class='h-full w-full'
                src='https://www.youtube.com/embed/JfjHup5MPSc'
                title='YouTube video player'
                frameborder='0'
                allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
                referrerpolicy='strict-origin-when-cross-origin'
                allowfullscreen></iframe>
            </div>
          </div>
        </div>
      </div>

      {/* Content */}
      <div class='flex flex-col lg:col-span-5'>
        <p class='text-lg leading-relaxed text-white/70'>
          Lorem ipsum dolor sit amet consectetur adipisicing elit. Molestiae incidunt, possimus aut eligendi, libero
          eveniet veritatis impedit nostrum consequuntur saepe aperiam. Nisi, beatae ipsam accusantium tenetur magni
          labore in esse voluptate assumenda doloribus ipsa.
        </p>

        {/* Stats */}
        <dl class='mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4'>
          <div
            class='group relative rounded-xl border border-white/10 bg-white/[0.02] p-6 transition-colors hover:border-accent/40 hover:bg-accent/[0.03]'>
            <dt class='text-[11px] font-medium uppercase tracking-[0.2em] text-white/50'>Career Success</dt>
            <dd class='mt-2 text-5xl font-bold text-white'>
              95<span class='text-accent'>%</span>
            </dd>
            <p class='mt-1 text-xs text-white/40'>Graduate placement rate</p>
          </div>

          <div
            class='group relative rounded-xl border border-white/10 bg-white/[0.02] p-6 transition-colors hover:border-accent/40 hover:bg-accent/[0.03]'>
            <dt class='text-[11px] font-medium uppercase tracking-[0.2em] text-white/50'>Active Students</dt>
            <dd class='mt-2 text-5xl font-bold text-white'>
              200<span class='text-accent'>+</span>
            </dd>
            <p class='mt-1 text-xs text-white/40'>Currently enrolled</p>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>
