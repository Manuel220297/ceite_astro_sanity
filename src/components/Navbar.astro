---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/programs', label: 'Programs' },
  { href: '/faculty', label: 'Faculty' },
  { href: '/news', label: 'Happenings' },
  { href: '/projects', label: 'Projects' },
  { href: '/contact', label: 'Contact' },
];
---

<nav
  class='fixed top-0 left-0 z-50 w-full font-(family-name:--font-tiktok) isolate shadow-[0_6px_24px_rgba(0,0,0,0.2),0_1px_3px_rgba(0,0,0,0.1)]'>
  {/* Layer 1: displaced backdrop */}
  <div
    class='absolute inset-0 rounded-[inherit] [filter:url(#liquid-glass)_saturate(150%)] backdrop-blur-[10px] isolate'>
  </div>

  {/* Layer 2: subtle tint */}
  <div class='absolute inset-0 rounded-[inherit] bg-linear-to-t from-0% from-white/8 to-20% to-black/40'></div>

  {/* Layer 3: specular highlight — the "wet" edge */}
  <div
    class='pointer-events-none absolute inset-0 rounded-[inherit] shadow-[inset_0px_1px_0_rgba(255,255,255,0.4),inset_0px_-1px_0px_rgba(255,255,255,0.16)]'>
  </div>

  {/* Layer 4: nav content, undistorted */}
  <div class='relative z-10 w-full px-6 py-4 lg:px-10 drop-shadow-md/50'>
    <div class='flex items-center justify-between gap-8'>
      <a href='/' class='flex shrink-0 items-center gap-2.5 text-white'>
        <img src='/images/ceite_small.webp' width='36' height='36' alt='' class='shrink-0' />
        <h2
          class='hidden md:block text-2xl text-transparent bg-clip-text bg-[linear-gradient(to_top,_#ffffff_33%,_#9f9f9f_50%,_#ffffff_67%)]'>
          C.E.I.T.E.
        </h2>
      </a>

      {/* Desktop Menu */}
      <div class='hidden flex-1 items-center justify-between lg:justify-start gap-0 lg:gap-8 md:flex'>
        {
          navLinks.map(({ href, label }) => {
            const isActive = href === '/' ? currentPath === '/' : currentPath.startsWith(href);
            return (
              <a
                href={href}
                aria-current={isActive ? 'page' : undefined}
                class={`text-sm transition-colors ${
                  isActive
                    ? 'relative font-semibold text-accent after:absolute after:-bottom-1.5 after:left-0 after:h-[2px] after:w-5 after:bg-accent'
                    : 'font-medium text-white/90 hover:text-accent'
                }`}>
                {label}
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</nav>

{/* SVG filter — hidden, referenced by the filter URL above */}
<svg class='hidden'>
  <filter id='liquid-glass' x='0%' y='0%' width='100%' height='100%'>
    <!-- Displacement -->
    <feImage
      href='data:image/png;base64,'
      preserveAspectRatio='none'></feImage>

    <!-- Refraction -->
    <feDisplacementMap in='SourceGraphic' scale='33' xChannelSelector='R' yChannelSelector='G'></feDisplacementMap>
  </filter>
</svg>
