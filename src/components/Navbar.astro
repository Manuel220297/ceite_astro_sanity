---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/programs', label: 'Programs' },
  { href: '/faculty', label: 'Faculty' },
  { href: '/news', label: 'Happenings' },
  { href: '/projects', label: 'Projects' },
  { href: '/contact', label: 'Contact' },
];
---

<nav
  class='fixed top-0 left-0 z-50 w-full font-(family-name:--font-tiktok) bg-white/4 isolate shadow-[0_6px_24px_rgba(0,0,0,0.2),0_1px_3px_rgba(0,0,0,0.1)]'>
  {/* Layer 1: displaced backdrop */}
  <div
    class='absolute inset-0 rounded-[inherit] backdrop-blur-[5px] [filter:url(#liquid-glass)_saturate(180%)] backdrop-brightness-90 isolate'>
  </div>

  {/* Layer 2: subtle tint */}
  <div class='absolute inset-0 rounded-[inherit] bg-white/5'></div>

  {/* Layer 3: specular highlight — the "wet" edge */}
  <div
    class='pointer-events-none absolute inset-0 rounded-[inherit] shadow-[inset_1px_1px_0_rgba(255,255,255,0.4),inset_0_0_6px_rgba(255,255,255,0.2)]'>
  </div>

  {/* Layer 4: nav content, undistorted */}
  <div class='relative z-10 mx-auto max-w-7xl px-6 py-5 lg:px-10 drop-shadow-lg/33'>
    <div class='flex items-center justify-between gap-8'>
      <a href='/' class='flex shrink-0 items-center gap-2.5 text-white'>
        <img src='/images/ceite_small.webp' width='36' height='36' alt='' class='shrink-0' />
      </a>

      {/* Desktop Menu */}
      <div class='hidden flex-1 items-center gap-8 md:flex'>
        {
          navLinks.map(({ href, label }) => {
            const isActive = href === '/' ? currentPath === '/' : currentPath.startsWith(href);
            return (
              <a
                href={href}
                aria-current={isActive ? 'page' : undefined}
                class={`text-sm transition-colors ${
                  isActive
                    ? 'relative font-semibold text-accent after:absolute after:-bottom-1.5 after:left-0 after:h-[2px] after:w-5 after:bg-accent'
                    : 'font-medium text-white/90 hover:text-accent'
                }`}>
                {label}
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</nav>

{/* SVG filter — hidden, referenced by the filter URL above */}
<svg class='hidden'>
  <filter id='liquid-glass' x='0%' y='0%' width='100%' height='100%'>
    <!-- <feTurbulence type='fractalNoise' baseFrequency='0.002 0.002' numOctaves='1' seed='92' result='noise'
    ></feTurbulence> -->
    <feGaussianBlur in='SourceGraphic' stdDeviation='1' result='blurred'></feGaussianBlur>
    <!-- Displacement -->
    <feImage
      href='data:image/png;base64,'
      preserveAspectRatio='none'></feImage>

    <!-- Specular -->
    <feImage
      href='data:image/png;base64,'
      preserveAspectRatio='none'
      result='specular_layer'></feImage>
    <feDisplacementMap
      in='SourceGraphic'
      in2='specular_layer'
      scale='33'
      xChannelSelector='R'
      yChannelSelector='G'
      result='displaced'></feDisplacementMap>
    <!-- <feColorMatrix in='displaced' type='saturate' values='50' result='displaced_saturated'></feColorMatrix>
    {/* Soften the rim */}
    <feGaussianBlur in='specular_layer' stdDeviation='1' result='specular_layer_blurred'></feGaussianBlur>

    {/* Mask saturated content by the blurred specular rim */}
    <feComposite in='displaced_saturated' in2='specular_layer_blurred' operator='in' result='specular_saturated'
    ></feComposite>

    <feBlend in='specular_saturated' in2='displaced' mode='normal'></feBlend> -->
  </filter>
</svg>
