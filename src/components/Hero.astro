<main class='relative min-h-screen w-full flex items-center justify-center'>
  {/* Background Image */}
  <div class='absolute inset-0'>
    <img src='/images/home_background.avif' alt='Background' class='w-full h-full object-cover' />
    <div class='absolute inset-0 bg-gradient-to-t from-black/75 from-10% to-black/33 to-90%'></div>
  </div>

  <div class='relative z-10 flex flex-col items-center text-center px-2 sm:px-6 mt-18 sm:mt-8'>
    {/* Logo */}
    <div class='flex flex-col justify-center items-center gap-6 mb-6 sm:mb-12'>
      <div class='flex items-center gap-4 bg-black/50 px-4 py-2 sm:px-6 border-accent/67 squircle rounded-full border'>
        <span
          class='w-1.5 h-1.5
          shrink-0
      inline-block
      rounded-full
      bg-accent
      animate-pulse
      shadow-[0px_0px_0px_5px_rgb(from_var(--color-accent)_r_g_b_/_0.15)]'
        ></span>

        <h3 class='text-[7.75px] sm:text-[9px] font-light text-white/75 uppercase tracking-widest sm:tracking-[0.3em]'>
          Asia Technological School of Science and Arts
        </h3>
      </div>
      <div
        class="relative inline-flex
          after:absolute
          after:-inset-3.5
          after:rounded-full
          after:animate-[spin_24s_linear_infinite]
          after:bg-[repeating-conic-gradient(theme(colors.accent/.35)_0deg_12deg,transparent_12deg_24deg)]
          after:[mask:radial-gradient(farthest-side,transparent_calc(100%-2px),white_0)]
          after:content-['']">
        <img
          width={80}
          src='/images/ceite_small.webp'
          class='drop-shadow-lg rounded-full p-2 bg-black/25 border border-accent/50'
          alt='Asiatech logo'
        />
      </div>
      <div class='text-white'>
        <div class='flex items-center gap-3 text-[12.5px] font-medium uppercase tracking-[0.35em] text-white/75'>
          <span class='h-[2px] w-16 bg-linear-to-r from-transparent via-accent to-transparent'></span>
          <span>College of Engineering &amp; IT Education</span>
          <span class='h-[2px] w-16 bg-linear-to-r from-transparent via-accent to-transparent' '></span>
        </div>
      </div>
    </div>

    {/* Main Title */}
    <h1 class='text-6xl sm:text-7xl md:text-8xl font-(family-name:--font-tiktok) text-white tracking-wide mb-2'>
      Build. Code. Engineer.
    </h1>

    {/* Subtitle */}
    <h2 class='text-[clamp(0.9rem,2vw,1.2rem)] max-w-[65ch] font-light text-stone-300 mb-8 w-full tracking-wider'>
      Become the Next Generation of Asiatechian Tech Pioneers. Lorem ipsum dolor sit amet consectetur adipisicing elit.
    </h2>

    {/* Scroll indicator */}
    <div class='flex flex-col items-center gap-3 mt-8'>
      <span class='text-[10px] tracking-[0.3em] uppercase text-stone-300'>Explore</span>

      <div class='relative flex items-center justify-center'>
        {/* Pulsing glow ring */}

        {/* Bouncing arrow */}
        <span class='relative flex size-12 items-center justify-center animate-bounce'>
          <svg
            class='h-8 w-5 text-white'
            viewBox='0 0 24 32'
            fill='none'
            stroke='currentColor'
            stroke-width='1.5'
            stroke-linecap='round'
            stroke-linejoin='round'
            aria-hidden='true'>
            <path d='M12 2v26M19 22l-7 7-7-7'></path>
          </svg>
        </span>
      </div>
    </div>
  </div>
</main>
