---
import { getCollection } from 'astro:content';
import SanityImage from '@/components/SanityImage.astro';

const news = await getCollection('news');
const pinnedNews = news.filter((n) => n.data.pin ?? false);
---

<main class='relative min-h-screen w-full flex items-center justify-center overflow-hidden'>
  {/* Background Image */}
  <div class='absolute inset-0'>
    <img src='/images/home_background.avif' alt='Background' class='w-full h-full object-cover select-none' />
    <div class='absolute inset-0 bg-black/44 bg-linear-to-t from-background from-3% to-45% to-transparent'></div>
  </div>

  <div class='relative z-10 flex flex-col items-center text-center sm:px-6 mt-26 w-full'>
    {/* Logo */}
    <div class='flex flex-col justify-center items-center gap-6 mb-6 sm:mb-12'>
      <div class='relative inline-flex hero-logo'>
        <img
          width={84}
          src='/images/ceite_small.webp'
          class='drop-shadow-lg rounded-full p-2 bg-linear-to-b from-accent/30 to-accent-1000/30 border border-accent/50'
          alt='Asiatech logo'
        />
      </div>
      <div class='text-white'>
        <div class='flex items-center gap-3 text-[12.5px] font-medium uppercase tracking-[0.35em] text-white/75'>
          <span class='h-[2px] w-16 bg-linear-to-r from-transparent via-accent to-transparent'></span>
          <h3
            class='text-[7.75px] sm:text-[9px] font-light text-white/75 uppercase tracking-widest sm:tracking-[0.3em]'>
            College of Engineering &amp; IT Education
          </h3>
          <span class='h-[2px] w-16 bg-linear-to-r from-transparent via-accent to-transparent'></span>
        </div>
      </div>
    </div>

    {/* Main Title */}
    <div class='relative inline-block'>
      <h1
        class='absolute inset-0 z-0 text-stroke text-[clamp(36px,4vw,80px)] font-(family-name:--font-tiktok) leading-none tracking-wider py-3'
        aria-hidden='true'>
        Build. Code. Engineer.
      </h1>

      <h1
        class='relative z-10 text-transparent bg-clip-text bg-linear-to-t from-stone-400 to-stone-100 text-[clamp(36px,4vw,80px)] font-(family-name:--font-tiktok) leading-none tracking-wider py-3'>
        Build. Code. Engineer.
      </h1>
    </div>
    {/* Subtitle */}
    <h4 class='text-[clamp(10px,1.25vw,20px)] max-w-[65ch] font-light text-stone-300 mb-8 px-2 w-full tracking-wider'>
      Become the Next Generation of Asiatechian Tech Pioneers. Lorem ipsum dolor sit amet consectetur adipisicing elit.
    </h4>

    <div class='group flex flex-col items-center gap-3 mt-8'>
      <a href='#about' class='custom-button'>Explore ↓</a>
    </div>

    {/* Pinned Posts Slider */}
    {
      pinnedNews.length > 0 && (
        <div class='mt-8 w-full max-w-3xl bg-black/25 p-4 rounded-4xl corner-squircle border border-stone-500/33'>
          {/* Header */}
          <div class='mb-5 flex flex-col gap-4 px-2 sm:flex-row sm:items-end sm:justify-between'>
            <div class='flex flex-col gap-2 text-start'>
              <span class='inline-flex w-fit items-center gap-2.5 text-[11px] font-semibold uppercase tracking-[0.3em] text-accent/90'>
                <span class='h-px w-6 bg-accent/60' />
                Featured
              </span>

              {/* Title */}
              <h2 class='flex items-center gap-3 text-2xl font-bold tracking-wide text-stone-100 sm:text-3xl'>
                <span>
                  <span class='text-accent'>Pinned</span> Posts
                </span>
                <span class='rounded-full border border-white/15 bg-white/5 px-2.5 py-0.5 text-xs font-medium text-stone-300'>
                  {pinnedNews.length}
                </span>
              </h2>

              {/* Subtitle */}
              <p class='text-sm leading-relaxed text-stone-400'>
                Stay updated with important announcements, updates, and highlights.
              </p>
            </div>
          </div>

          {/* Pagination */}
          <div id='hero-pagination' class='swiper-pagination mb-3 !static !flex !justify-start !text-start' />

          <div
            id='swiper-pinned'
            class='swiper relative sm:rounded-2xl overflow-hidden border border-white/10 bg-black/30'>
            <div class='swiper-wrapper'>
              {pinnedNews.map((n) => (
                <div class='swiper-slide'>
                  <a
                    href={`/news/${n.data.slug}`}
                    class='group/pin relative block w-full overflow-hidden aspect-square sm:aspect-video bg-black'>
                    {/* Image */}
                    <SanityImage
                      image={n.data.image}
                      width={1024}
                      loading='lazy'
                      class='absolute inset-0 size-full object-cover select-none
                      transition-transform duration-700 ease-out
                      group-hover/pin:scale-105 group-hover/pin:rotate-[0.3deg]'
                    />

                    <div class='absolute inset-0 bg-linear-to-b from-black/60 via-black/10 to-transparent' />

                    {/* Hover overlay */}
                    <div
                      class='absolute inset-0 opacity-0 group-hover/pin:opacity-100
                bg-black/40 transition-opacity duration-300'
                    />

                    <div class='absolute inset-0 flex flex-col justify-start p-6 sm:p-8'>
                      <div
                        class='space-y-3 transition-all duration-300
                  group-hover/pin:translate-y-[-2px]'>
                        {n.data.category && (
                          <span
                            class='inline-flex w-fit items-center gap-2
                       rounded-full border border-white/20
                       bg-black/30 px-3 py-1
                       text-[10px] font-semibold tracking-[0.25em] uppercase
                       text-white/90
                       transition-all duration-300
                       group-hover/pin:bg-white/10'>
                            ♦ {n.data.category}
                          </span>
                        )}

                        <h3
                          class='font-semibold text-white
                          text-center
                          mx-auto
                   text-[clamp(14px,1.6vw,28px)]
                   leading-tight
                   max-w-[90%]
                   drop-shadow-md'>
                          {n.data.title}
                        </h3>
                      </div>
                    </div>

                    <div class='absolute inset-0 flex items-center justify-center'>
                      <div
                        class='opacity-0 scale-95
                  group-hover/pin:opacity-100 group-hover/pin:scale-100
                  transition-all duration-300 ease-out'>
                        <span
                          class='text-white text-lg sm:text-xl font-semibold tracking-[0.2em] uppercase
                     border border-white/30 bg-black/40
                     px-6 py-3 rounded-full
                     '>
                          Read Article
                        </span>
                      </div>
                    </div>

                    <div
                      class='absolute inset-0 ring-1 ring-white/0
                group-hover/pin:ring-white/15
                transition-all duration-300'
                    />
                  </a>
                </div>
              ))}
            </div>

            {/* navigator */}
            <div class='swiper-button-prev' />
            <div class='swiper-button-next' />
          </div>
        </div>
      )
    }
  </div>
</main>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay, Keyboard } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/pagination';

  let pinnedSwiper: Swiper | null = null;

  function initPinnedSwiper() {
    const el = document.querySelector('#swiper-pinned');
    if (!el) return;

    if (pinnedSwiper) {
      pinnedSwiper.destroy(true, true);
      pinnedSwiper = null;
    }

    pinnedSwiper = new Swiper('#swiper-pinned', {
      modules: [Navigation, Pagination, Autoplay, Keyboard],
      slidesPerView: 1,
      spaceBetween: 0,
      loop: true,
      speed: 600,
      keyboard: { enabled: true },
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },
      navigation: {
        nextEl: '#swiper-pinned .swiper-button-next',
        prevEl: '#swiper-pinned .swiper-button-prev',
      },
      pagination: {
        el: '#hero-pagination',
        clickable: true,
      },
    });
  }

  document.addEventListener('astro:page-load', initPinnedSwiper);

  document.addEventListener('astro:before-swap', () => {
    if (pinnedSwiper) {
      pinnedSwiper.destroy(true, true);
      pinnedSwiper = null;
    }
  });
</script>
