<main class='relative min-h-screen w-full flex items-center justify-center bg-olive-400'>
  {/* Background Image */}
  <div class='absolute inset-0'>
    <img src='/images/home_background.jpg' alt='Background' class='w-full h-full object-cover' />
    <div class='absolute inset-0 bg-gradient-to-t from-black/70 from-10% to-black/10 to-90%'></div>
  </div>

  <div class='relative z-10 flex flex-col items-center text-center px-2 sm:px-6'>
    {/* Logo + School Name */}
    <div class='flex flex-col justify-center items-center gap-3 mb-6'>
      <img width={50} src='/images/ceite_small.webp' class='drop-shadow-lg' alt='Asiatech logo' />
      <div class='text-white'>
        <div class='mb-1 flex items-center justify-center gap-3'>
          <span class='h-px w-10 bg-accent'></span>
          <h2
            class='text-4xl md:text-4xl font-(family-name:--font-tiktok) text-transparent bg-clip-text bg-[linear-gradient(to_top,_#ffffff_33%,_#9f9f9f_50%,_#ffffff_67%)]'>
            C.E.I.T.E.
          </h2>
          <span class='h-px w-10 bg-accent'></span>
        </div>
        <div class='flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.3em] text-white/75'>
          <span>College of Engineering &amp; IT Education</span>
        </div>
      </div>
    </div>

    {/* Main Title */}
    <h1
      class='expanded text-5xl sm:text-6xl md:text-[5rem] font-(family-name:--font-tiktok) font-black text-white tracking-wide mb-2'>
      Build. Code. Engineer.
    </h1>

    {/* Subtitle */}
    <h2 class='text-lg md:text-4xl text-primary font-semibold text-accent mb-8 w-full tracking-wide'>
      Become the Next Generation of Asiatechian Tech Pioneers.
    </h2>

    {/* Scroll indicator */}
    <div class='flex flex-col items-center gap-3 mt-8'>
      <span class='text-[10px] tracking-[0.3em] uppercase text-stone-300'>Explore</span>

      <div class='relative flex items-center justify-center'>
        {/* Pulsing glow ring */}

        {/* Bouncing arrow */}
        <span class='relative flex size-12 items-center justify-center animate-bounce'>
          <svg
            class='h-8 w-5 text-white'
            viewBox='0 0 24 32'
            fill='none'
            stroke='currentColor'
            stroke-width='1.5'
            stroke-linecap='round'
            stroke-linejoin='round'
            aria-hidden='true'>
            <path d='M12 2v26M19 22l-7 7-7-7'></path>
          </svg>
        </span>
      </div>
    </div>
  </div>
</main>
