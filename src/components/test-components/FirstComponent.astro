<a href='/' class='bg-amber-300 px-8 py-4'>Home</a>
<div
  id='box'
  class='size-16 bg-blue-500 rounded-xl text-white font-bold flex justify-center items-center cursor-pointer'>
  <p class='select-none'>Div</p>
</div>

<button id='rotateBtn'>Rotate box</button>
<div
  id='cssBox'
  style='
    filter: saturate(0%);
    transform: rotate(30deg);
    width: 64px;
    height: 64px;
    '
  class='bg-[url(/images/asiatech_logo.avif)] bg-cover bg-center rounded-full flex justify-center items-center'>
</div>
<div id='activeContent' class='hidden'>
  <p>This content is active</p>
</div>

<script>
  import { animate, spring } from 'animejs';
  let isActive = false;
  const box = document.querySelector('#box');
  const button = document.querySelector('#rotateBtn');
  const activeContent = document.querySelector('#activeContent');

  const rotateBox = () => {
    animate(box!, {
      rotate: [{ to: isActive ? 0 : 360, duration: 1000, ease: 'out(4)' }],
    });

    animate('#cssBox', {
      filter: [
        {
          to: isActive ? 'saturate(0%)' : 'saturate(100%)',
          ease: 'out(4)',
          duration: 600,
        },
      ],
      rotate: [{ to: isActive ? 30 : 0, ease: 'out(4)', duration: 600 }],
      scale: [
        {
          to: isActive ? 1 : 1.15,
          ease: spring({
            stiffness: 69.441,
            damping: 3.833,
            mass: 1,
            velocity: 0,
          }),
          duration: 250,
        },
      ],
    });

    if (isActive) {
      // EXIT
      animate(activeContent!, {
        opacity: [1, 0],
        duration: 250,
        easing: 'out(4)',
        onComplete: () => {
          activeContent?.classList.add('hidden');
        },
      });
    } else {
      // ENTER
      activeContent?.classList.remove('hidden');

      animate(activeContent!, {
        opacity: [0, 1],
        duration: 250,
        easing: 'out(4)',
      });
    }
    isActive = !isActive;
  };

  animate(box!, {
    scale: [
      { to: 1.25, ease: 'inOut(3)', duration: 200 },
      { to: 1, ease: spring({ bounce: 0.7 }) },
    ],
    loop: true,
    loopDelay: 250,
  });

  box?.addEventListener('click', rotateBox);
</script>
