---
import { getCollection } from 'astro:content';

const programs = (await getCollection('programs')).sort(
  (a, b) => a.data._createdAt.getTime() - b.data._createdAt.getTime(),
);
---

<div id='program-tab' class='flex flex-1 gap-24 py-4 px-4 overflow-x-auto scroll-smooth'>
  {
    programs.map((program, index) => (
      <div class='tab flex-col gap-4 flex justify-center items-center flex-shrink-0' data-target={`content-${index}`}>
        <img
          style='    
            filter: saturate(0%);
            transform: rotate(30deg);
            width: 96px;
            height: 96px;'
          src='/images/asiatech_logo.avif'
          class='cursor-pointer object-contain'
        />
        <p class='font-light'>{program.data.title}</p>
      </div>
    ))
  }
</div>

<section class='flex flex-col gap-8'>
  {
    programs.map((program, index) => (
      <article id={`content-${index}`} class='content hidden col h-[67vh]'>
        <h1 class='text-7xl'>{program.data.title}</h1>
        <h2 class='text-3xl'>
          {program.data.titleLong} Index: {index}
        </h2>
        <h3 class='text-xl'>Tags</h3>
        <ul class='flex gap-4'>
          {program.data.specializations?.map((s: any) => (
            <li>{s}</li>
          ))}
        </ul>
      </article>
    ))
  }
</section>

<script>
  import { animate, spring } from 'animejs';

  let activeTab: HTMLElement | null = null;

  const programTab = document.querySelector('#program-tab');
  const tabs = programTab?.querySelectorAll('.tab') ?? [];
  const contents = document.querySelectorAll('.content');

  // --- Utilities ---
  function removeHidden(id: string) {
    contents.forEach((c) => c.classList.add('hidden'));
    document.getElementById(id)?.classList.remove('hidden');
  }

  // --- Animations ---
  const animateActiveTab = (target: HTMLElement) => {
    animate(target, {
      filter: 'saturate(100%)',
      scale: [
        { to: 1.15, ease: 'inOut(3)', duration: 200 },
        { to: 1.0, ease: spring({ bounce: 0.7 }) },
      ],
    });
  };

  const animateInactiveTab = (target: HTMLElement) => {
    animate(target, {
      scale: [
        { to: 0.95, ease: 'inOut(3)', duration: 200 },
        { to: 0.83, ease: spring({ bounce: 0.7 }) },
      ],
      filter: 'saturate(0%)',
    });
  };

  // --- Core Logic (Single Source of Truth) ---
  function setActiveTab(nextTab: HTMLElement) {
    // unnecessary work
    if (activeTab === nextTab) return;

    // 1. Deactivate previous
    if (activeTab) {
      activeTab.classList.remove('active');

      const prevImg = activeTab.querySelector('img');
      if (prevImg) animateInactiveTab(prevImg);
    }

    // 2. Activate new
    nextTab.classList.add('active');

    const nextImg = nextTab.querySelector('img');
    if (nextImg) animateActiveTab(nextImg);

    // 3. Update content
    const targetId = nextTab.dataset.target;
    if (targetId) removeHidden(targetId);

    // 4. Update state
    activeTab = nextTab;
  }

  // --- Event Binding ---
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      setActiveTab(tab as HTMLElement);
    });
  });

  // --- Initial State ---
  const firstTab = tabs[0] as HTMLElement | undefined;

  if (firstTab) {
    setActiveTab(firstTab);
  }
</script>
