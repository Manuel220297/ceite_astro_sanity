---
import FacebookIcon from '../assets/icons/FacebookIcon.astro';
import TikTokIcon from '../assets/icons/TikTokIcon.astro';
import InstagramIcon from '../assets/icons/InstagramIcon.astro';
import YoutubeIcon from '../assets/icons/YoutubeIcon.astro';
import ArrowUpIcon from '../assets/icons/ArrowUpIcon.astro';

const socialLinks = [
  { icon: FacebookIcon, label: 'IT & CS', handle: 'facebook.com/ceite.itcs' },
  { icon: FacebookIcon, label: 'CpE', handle: 'facebook.com/ceite.cpe' },
  { icon: FacebookIcon, label: 'C.E.I.T.E', handle: 'facebook.com/ceite' },
  { icon: FacebookIcon, label: 'Asiatech', handle: 'facebook.com/asiatech' },
  { icon: TikTokIcon, label: '@asiatech.official', handle: 'tiktok' },
  { icon: InstagramIcon, label: 'asiatechofficial', handle: 'instagram' },
  { icon: YoutubeIcon, label: 'AsiatechTV', handle: 'youtube' },
];

const contactRows = [
  { label: 'Telephone', values: ['(049) 302-0477', '530-2717'] },
  { label: 'Mobile', values: ['0927 822 3741', '0123 456 789'] },
  { label: 'Email', values: ['info@asiatech.edu.ph', 'asiatechnological@yahoo.com'] },
  { label: 'Website', values: ['asiatech.edu.ph'] },
];

const year = new Date().getFullYear();
---

<footer class='footer relative w-full overflow-hidden bg-stone-900 mt-auto'>
  {/* Ambient accent glow */}
  <div class='pointer-events-none absolute -top-32 left-1/4 size-[500px] rounded-full bg-accent/5 blur-[120px]'></div>
  <div
    class='pointer-events-none absolute -bottom-32 right-1/4 size-[400px] rounded-full bg-accent/[0.03] blur-[100px]'>
  </div>

  {/* Top meta bar */}
  <div
    class='relative z-10 mx-auto flex w-full max-w-[1600px] items-center gap-4 px-6 pt-12 md:px-12 lg:px-18 text-[10px] md:text-xs tracking-[0.25em] text-stone-500 mb-12'>
    <span class='flex items-center gap-2'>
      <span class='relative inline-block size-1.5 rounded-full bg-accent'>
        <span class='absolute inset-0 animate-ping rounded-full bg-accent/70'></span>
      </span>
      <span class='uppercase text-stone-300'>Get in Touch</span>
    </span>
    <span class='h-px flex-1 bg-linear-to-r from-stone-700/80 via-stone-700/30 to-transparent'></span>
    <span class='flex items-center gap-2 cursor-pointer group/top'>
      <span class='uppercase'>Back to top</span>
      <span
        class='flex size-7 items-center justify-center rounded-full border border-stone-700 transition-all group-hover/top:border-accent group-hover/top:bg-accent/10'>
        <ArrowUpIcon class='size-3 transition-transform group-hover/top:-translate-y-0.5' />
      </span>
    </span>
  </div>

  {/* Main */}
  <div class='relative z-10 mx-auto max-w-[1600px] px-6 md:px-12 xl:px-18 pb-10'>
    <div class='flex flex-col xl:flex-row gap-12 xl:gap-16 border-b border-stone-700/50 pb-12'>
      {/* COLUMN 1 — Brand + Socials */}
      <div class='flex flex-col gap-8 xl:w-[34%] xl:shrink-0'>
        {/* CEITE brand */}
        <div class='flex items-center gap-3 text-white'>
          <img src='/images/ceite_small.webp' alt='CEITE Logo' class='shrink-0 size-14 md:size-16' />
          <div class='flex flex-col'>
            <h3
              class='text-3xl md:text-4xl text-transparent tracking-wider bg-clip-text font-(family-name:--font-tiktok) bg-[linear-gradient(to_top,_#ffffff_33%,_#9f9f9f_50%,_#ffffff_67%)] leading-none'>
              C.E.I.T.E.
            </h3>
            <p class='text-[8px] sm:text-[9px] text-stone-400 mt-1 whitespace-nowrap'>
              College of <span class='text-accent'>Engineering</span> and <span class='text-accent'
                >Information Technology</span
              > Education
            </p>
          </div>
        </div>

        {/* Asiatech brand */}
        <div class='flex items-center gap-3 text-white'>
          <img src='/images/asiatech_logo.avif' alt='Asiatech Logo' class='shrink-0 size-14 md:size-16' />
          <div class='flex flex-col'>
            <h3
              class='text-3xl md:text-4xl text-transparent tracking-wider bg-clip-text font-serif font-bold bg-linear-to-tr from-stone-300 to-stone-100 leading-none'>
              ASIATECH
            </h3>
            <p class='text-[8px] sm:text-[9px] uppercase tracking-wide text-stone-400 mt-1 whitespace-nowrap'>
              Asia Technological School of Science and Arts
            </p>
          </div>
        </div>

        {/* Social links */}
        <div class='flex flex-col gap-3 mt-2'>
          <div class='flex items-center gap-3'>
            <span class='h-px w-6 bg-accent'></span>
            <span class='text-[10px] tracking-[0.3em] uppercase text-stone-500'>Social</span>
          </div>
          <div class='flex flex-wrap gap-2'>
            {
              socialLinks.map((s) => (
                <span class='group/social flex items-center gap-2 rounded-full border border-stone-700/70 bg-white/[0.02] px-3 py-1.5 text-xs text-stone-300 backdrop-blur-md transition-all hover:border-accent/50 hover:bg-accent/10 hover:text-accent cursor-pointer'>
                  <span class='shrink-0 [&_svg]:size-3.5'>
                    <s.icon />
                  </span>
                  <span class='font-medium'>{s.label}</span>
                </span>
              ))
            }
          </div>
        </div>
      </div>

      {/* COLUMN 2 — Contact */}
      <div class='flex flex-col gap-5 xl:flex-1'>
        <div class='flex items-center gap-3'>
          <span class='h-px w-6 bg-accent'></span>
          <span class='text-[10px] tracking-[0.3em] uppercase text-stone-500'>Contact</span>
        </div>

        <div class='flex flex-col gap-4'>
          {
            contactRows.map((row) => (
              <div class='flex flex-col sm:flex-row sm:items-start sm:gap-6 border-b border-stone-800/80 pb-4 last:border-b-0'>
                <span class='text-[10px] tracking-[0.25em] uppercase text-stone-500 sm:w-24 sm:shrink-0 sm:pt-1'>
                  {row.label}
                </span>
                <div class='flex flex-col gap-0.5'>
                  {row.values.map((v) => (
                    <span class='text-sm tracking-wide text-stone-200 hover:text-accent transition-colors cursor-pointer'>
                      {v}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      {/* COLUMN 3 — Address + Map */}
      <div class='flex flex-col gap-5 xl:w-[28%] xl:shrink-0'>
        <div class='flex items-center gap-3'>
          <span class='h-px w-6 bg-accent'></span>
          <span class='text-[10px] tracking-[0.3em] uppercase text-stone-500'>Address</span>
        </div>

        {/* Address */}
        <div class='flex flex-col gap-2'>
          <p class='text-sm leading-relaxed text-stone-200'>
            1506 National Highway <span class='text-stone-400'>(Entrance of Golden City)</span>, Brgy. Dila, City of
            Santa Rosa, <span class='text-accent'>Laguna</span>
          </p>
        </div>

        {/* Map */}
        <div class='group/map relative overflow-hidden rounded-2xl border border-stone-700/50 aspect-[4/3]'>
          <img
            src='https://placehold.co/600x450/1c1917/57534e?text=Campus+Map'
            alt='Campus location map'
            class='size-full object-cover saturate-50 transition-all duration-500 group-hover/map:saturate-100 group-hover/map:scale-105'
          />
          {/* Pin marker */}
          <div class='absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2'>
            <span class='relative flex size-3 items-center justify-center'>
              <span class='absolute size-6 rounded-full bg-accent/30 animate-ping'></span>
              <span
                class='relative size-3 rounded-full bg-accent shadow-[0_0_12px_2px_rgb(from_var(--color-accent)_r_g_b_/_0.6)]'
              ></span>
            </span>
          </div>
          {/* Gradient overlay */}
          <div
            class='pointer-events-none absolute inset-0 bg-linear-to-t from-stone-900/60 via-transparent to-transparent'>
          </div>
          {/* "View on map" tag */}
          <div
            class='absolute bottom-3 left-3 flex items-center gap-2 rounded-full border border-white/15 bg-black/50 px-3 py-1 backdrop-blur-md cursor-pointer'>
            <span class='size-1.5 rounded-full bg-accent'></span>
            <span class='text-[10px] tracking-[0.2em] uppercase text-stone-100'>View on map</span>
          </div>
        </div>
      </div>
    </div>

    {/* Bottom row */}
    <div class='flex flex-row items-center justify-center pt-8'>
      <p class='text-sm text-stone-400'>
        &copy; {year} Asia Technological School of Science and Arts . All rights reserved.
      </p>
    </div>
  </div>
</footer>
