---
import { urlFor } from '../lib/sanity/image';
import clsx from 'clsx';
import { DEFAULT_IMAGE } from '../lib/fallbackImages';
import type { DefaultImage } from '../lib/fallbackImages';

interface Props {
  image?: any;
  alt?: string;
  class?: string;
  fallback?: DefaultImage;
  loading?: 'lazy' | 'eager';
  width?: number;
  height?: number;
  unoptimized?: boolean;
}

const {
  image,
  alt = '',
  fallback = DEFAULT_IMAGE.KEYBOARD,
  class: className,
  loading,
  width,
  height,
  unoptimized = false,
} = Astro.props;

const w = width || 800;
const h = height;

if (unoptimized) {
}
const hasImage = image?.asset?._ref;

const src = hasImage
  ? unoptimized
    ? urlFor(image).url()
    : urlFor(image).width(w).height(h!).format('webp').url()
  : fallback;
---

<img src={src} alt={alt} class={clsx('', className)} loading={loading || 'lazy'} />
