---
import { urlFor } from '../lib/sanity/image';
import clsx from 'clsx';
import { DEFAULT_IMAGE } from '../lib/fallbackImages';
import type { DefaultImage } from '../lib/fallbackImages';

interface Props {
  image?: any;
  alt?: string;
  class?: string;
  fallback?: DefaultImage;
  loading?: 'lazy' | 'eager';
  width?: number;
  height?: number;
  unoptimized?: boolean;
  Xparallax?: number;
  Yparallax?: number;
  format?: 'png' | 'jpg' | 'webp' | 'none';
}

const {
  image,
  alt = '',
  fallback = DEFAULT_IMAGE.KEYBOARD,
  class: className,
  loading,
  width,
  height,
  unoptimized = false,
  Xparallax = 0,
  Yparallax = 0,
  format = 'webp',
} = Astro.props;

const w = width || 800;
const h = height;

// SAFE IMAGE CHECKS
// ─────────────────────────────
const hasImage = image?.asset?.url || image?.asset?._ref;
const assetSize: number = image?.asset?.size ?? 0;

// Skip optimization if:
// - manually disabled
// - image < 60KB
const shouldSkipOptimization = unoptimized || (assetSize > 0 && assetSize < 60 * 1024);

// Debug
//  ─────────────────────────────
// console.log(
//   'Image:',
//   image?.asset?.url,
//   '\nSize:',
//   (assetSize / 1024).toFixed(2),
//   'kb',
//   '\nSkip optimization:',
//   shouldSkipOptimization,
// );

// BUILD IMAGE URL
// ─────────────────────────────
const builder = hasImage ? urlFor(image) : null;

const processed = builder
  ? shouldSkipOptimization
    ? builder.url()
    : (() => {
        let img = builder.width(w);

        if (h) {
          img = img.height(h);
        }

        if (format !== 'none') {
          img = img.format(format);
        }

        return img.url();
      })()
  : null;

// Fallback Image
const src = processed || fallback;

// STYLE ONLY FOR NON-OPTIMIZED IMAGES
// ─────────────────────────────
const hotspotX = image?.hotspot?.x ?? 0.5;
const hotspotY = image?.hotspot?.y ?? 0.5;

const objectPosition = `${hotspotX * 100}% ${hotspotY * 100}%`;

const baseImageStyle = `
  object-position: ${objectPosition};
`;

let sizeStyle = '';

if (shouldSkipOptimization) {
  sizeStyle = `
    width: ${w}px;
    ${h ? `height: ${h}px;` : ''}
  `;
}

const finalStyle = `${baseImageStyle} ${sizeStyle}`;
---

<img
  data-swiper-parallax-x={`${Xparallax}%`}
  data-swiper-parallax-y={`${Yparallax}%`}
  src={src}
  alt={alt}
  style={finalStyle}
  class={clsx('object-cover', className)}
  loading={loading || 'lazy'}
  width={w}
  height={h}
/>
