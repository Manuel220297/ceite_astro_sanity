---
import { urlFor } from '../lib/sanity/image';
import clsx from 'clsx';
import { DEFAULT_IMAGE } from '../lib/fallbackImages';
import type { DefaultImage } from '../lib/fallbackImages';

interface Props {
  image?: any;
  alt?: string;
  class?: string;
  fallback?: DefaultImage;
  loading?: 'lazy' | 'eager';
  width?: number;
  height?: number;
  unoptimized?: boolean;
  Xparallax?: number;
  Yparallax?: number;
  format?: 'png' | 'jpg' | 'webp' | 'none';
}

const {
  image,
  alt = '',
  fallback = DEFAULT_IMAGE.KEYBOARD,
  class: className,
  loading,
  width,
  height,
  unoptimized = false,
  Xparallax = 0,
  Yparallax = 0,
  format = 'webp',
} = Astro.props;

const w = width || 800;
const h = height;

if (unoptimized) {
}
const hasImage = image?.asset?._ref;

const builder = hasImage ? urlFor(image) : null;

const processed = builder
  ? unoptimized
    ? builder.url()
    : (() => {
        let img = builder.width(w).height(h!);

        if (format !== 'none') {
          img = img.format(format);
        }

        return img.url();
      })()
  : null;

const src = processed || fallback;
---

<img
  data-swiper-parallax-x={`${Xparallax}%`}
  data-swiper-parallax-y={`${Yparallax}%`}
  src={src}
  alt={alt}
  class={clsx('', className)}
  loading={loading || 'lazy'}
/>
