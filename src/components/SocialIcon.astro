---
interface Props {
  name: string;
}
const { name } = Astro.props;
---

{
  name === 'email' && (
    <svg
      class='size-4'
      viewBox='0 0 24 24'
      fill='none'
      stroke='currentColor'
      stroke-width='2'
      stroke-linecap='round'
      stroke-linejoin='round'>
      <rect x='2' y='4' width='20' height='16' rx='2' />
      <path d='m22 7-10 5L2 7' />
    </svg>
  )
}
{
  name === 'facebook' && (
    <svg class='size-4' viewBox='0 0 24 24' fill='currentColor'>
      <path d='M9.198 21.5h4v-8.01h3.604l.396-3.98h-4V7.5a1 1 0 0 1 1-1h3v-4h-3a5 5 0 0 0-5 5v2.01h-2l-.396 3.98h2.396z' />
    </svg>
  )
}
{
  name === 'tiktok' && (
    <svg class='size-4' viewBox='0 0 24 24' fill='currentColor'>
      <path d='M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.78a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.84-.21Z' />
    </svg>
  )
}
{
  name === 'twitter' && (
    <svg class='size-4' viewBox='0 0 24 24' fill='currentColor'>
      <path d='M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z' />
    </svg>
  )
}
{
  name === 'instagram' && (
    <svg
      class='size-4'
      viewBox='0 0 24 24'
      fill='none'
      stroke='currentColor'
      stroke-width='2'
      stroke-linecap='round'
      stroke-linejoin='round'>
      <rect x='2' y='2' width='20' height='20' rx='5' />
      <path d='M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z' />
      <line x1='17.5' y1='6.5' x2='17.51' y2='6.5' />
    </svg>
  )
}
