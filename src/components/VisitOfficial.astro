---
import FacebookIcon from '../assets/icons/FacebookIcon.astro';
import TikTokIcon from '../assets/icons/TikTokIcon.astro';
import InstagramIcon from '../assets/icons/InstagramIcon.astro';
import YoutubeIcon from '../assets/icons/YoutubeIcon.astro';
import Breadcrumb from './Breadcrumb.astro';

const facebookPages = [
  { label: 'C.E.I.T.E.', handle: '/ceite.asiatech', href: 'https://facebook.com/ceite.asiatech' },
  { label: 'IT & CS', handle: '/asiatech.itcs', href: 'https://facebook.com/asiatech.itcs' },
  { label: 'CpE', handle: '/asiatech.cpe', href: 'https://facebook.com/asiatech.cpe' },
  { label: 'Asiatech Official', handle: '/asiatech.official', href: 'https://facebook.com/asiatech.official' },
];

const socials = [
  {
    name: 'TikTok',
    handle: '@asiatech.official',
    href: 'https://tiktok.com/@asiatech.official',
    color: '#ff0050',
    Icon: TikTokIcon,
  },
  {
    name: 'Instagram',
    handle: '@asiatechofficial',
    href: 'https://instagram.com/asiatechofficial',
    color: '#e1306c',
    Icon: InstagramIcon,
  },
  {
    name: 'YouTube',
    handle: 'AsiatechTV',
    href: 'https://youtube.com/@AsiatechTV',
    color: '#ff0000',
    Icon: YoutubeIcon,
  },
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id='visit-official-section' class='relative w-full overflow-hidden bg-background py-24 md:py-32'>
  {/* Ambient glow */}
  <div
    class='pointer-events-none absolute -bottom-32 right-1/4 size-[500px] rounded-full bg-accent/[0.04] blur-[120px]'>
  </div>

  <Breadcrumb
    class='max-w-[1600px] mx-auto px-2 md:px-6 mb-12'
    tail={`${pad(facebookPages.length + socials.length + 1)} PAGES`}
    items={[{ label: 'CONNECT' }, { label: 'OFFICIAL SOCIALS' }]}
  />

  {/* Headline */}
  <header class='relative z-10 mx-auto mb-16 max-w-4xl px-6 text-center'>
    <div class='mb-4 flex items-center justify-center gap-3'>
      <span class='h-px w-8 bg-accent'></span>
      <span class='text-[10px] tracking-[0.3em] uppercase text-accent'>Stay Updated</span>
      <span class='h-px w-8 bg-accent'></span>
    </div>
    <h2 class='font-(family-name:--font-tiktok) text-5xl leading-[0.95] sm:text-6xl md:text-7xl'>
      <span class='block text-stone-50'>Visit Our</span>
      <span class='block text-accent'>Official Pages<span class='text-accent/70'>.</span></span>
    </h2>
    <p class='mx-auto mt-6 max-w-xl text-sm leading-relaxed text-stone-400 sm:text-base'>
      Follow our official channels for the latest news, events, and announcements from across the college.
    </p>
  </header>

  <div class='relative z-10 mx-auto w-full max-w-[1200px] px-6 md:px-10 flex flex-col gap-6'>
    {/* Featured Website card */}
    <a
      href='https://asiatech.edu.ph'
      target='_blank'
      rel='noopener noreferrer'
      class='group aspect-square md:aspect-[20/9] relative
      overflow-hidden corner-squircle rounded-2xl border border-white/10 transition-all duration-500 hover:border-accent/40'>
      {/* Background image */}
      <img
        src='/images/default_background.avif'
        alt=''
        class='absolute inset-0 size-full object-cover transition-transform duration-700 group-hover:scale-105'
      />

      <div class='absolute inset-0 bg-black/70 group-hover:bg-black/25 transition-colors duration-500 ease-in-out'>
      </div>
      <div
        class='absolute inset-0 bg-linear-to-b sm:bg-linear-to-r from-green-700/25 to-accent-600/25 group-hover:from-green-700/60 group-hover:to-accent-600/60 transition-colors duration-500 ease-in-out'>
      </div>

      {/* Decorative grid pattern overlay — optional ambient texture */}
      <div class='pointer-events-none absolute inset-0 pattern-graph'></div>

      {/* Content */}
      <div class='relative z-10 flex flex-col gap-6 p-8 sm:p-10 md:p-14 h-full justify-center items-center'>
        <div class='relative inline-flex'>
          <img
            width={80}
            src='/images/asiatech_logo.avif'
            class='drop-shadow-lg/80 rounded-full p-2 bg-linear-to-b from-green-500/40 to-accent-500/40 border-[1.25px] border-black/33'
            alt='Asiatech logo'
          />
        </div>
        {/* Title */}
        <div class='flex flex-col gap-3 text-center'>
          <h3
            class='font-semibold text-3xl sm:text-4xl tracking-wider md:text-5xl leading-[0.95] text-stone-50 drop-shadow-[0_4px_20px_rgba(0,0,0,0.6)]'>
            <span class='font-serif font-black'>ASIATECH</span> Website
          </h3>
          <p class='text-sm mx-auto sm:text-base text-stone-300 leading-relaxed'>
            The official home of Asia Technological School of Science and Arts
          </p>
        </div>

        {/* CTA pill */}
        <div class='mt-auto flex items-center justify-between gap-2 flex-wrap'>
          <div class='flex items-center gap-2 text-[10px] tracking-[0.3em] uppercase text-stone-400'>
            <svg
              class='size-3.5 text-accent'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'>
              <circle cx='12' cy='12' r='10'></circle>
              <path d='M2 12h20M12 2a15 15 0 010 20M12 2a15 15 0 000 20'></path>
            </svg>
            <span class='group-hover:text-accent transition-colors'>Asia Technological School of Science and Arts</span>
          </div>

          <span
            class='inline-flex items-center gap-2 rounded-full border border-accent/40 bg-accent/10 px-5 py-2.5 text-xs font-semibold tracking-[0.2em] uppercase text-accent transition-all group-hover:border-accent group-hover:bg-accent group-hover:text-background'>
            <span>asiatech.edu.ph</span>
            <svg
              class='size-3.5 transition-transform group-hover:translate-x-1'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'>
              <path d='M7 17L17 7M17 7H8M17 7v9'></path>
            </svg>
          </span>
        </div>
      </div>
    </a>

    {/* Other channels row */}
    <div class='flex flex-wrap gap-2'>
      {/* Facebook with dropdown */}
      <div
        class='channel-card facebook-dropdown group relative basis-full sm:basis-[calc((100%-1rem)/2)] lg:basis-[calc((100%-2rem)/3)] xl:basis-[calc((100%-3rem)/4)]'
        data-fb-dropdown>
        <button
          type='button'
          class='facebook-toggle flex w-full items-center gap-4 corner-squircle rounded-xl border border-white/10 bg-white/[0.02] px-6 py-5 transition-all duration-300 hover:border-[#1877f2]/40 hover:bg-[#1877f2]/5 cursor-pointer'
          aria-expanded='false'
          aria-haspopup='true'>
          <span
            class='flex size-12 shrink-0 items-center justify-center rounded-full border border-[#1877f2]/40 bg-[#1877f2]/10 text-[#1877f2] transition-colors group-hover:bg-[#1877f2]/20 [&_svg]:size-5'>
            <FacebookIcon />
          </span>
          <div class='flex flex-col gap-0.5 flex-1 text-left min-w-0'>
            <span class='text-[10px] tracking-[0.3em] uppercase text-stone-500'>Facebook</span>
            <span class='text-base font-bold text-stone-50 group-hover:text-[#1877f2] transition-colors'>
              {facebookPages.length} Pages
            </span>
          </div>
          <svg
            class='facebook-chevron size-4 text-stone-400 transition-transform shrink-0'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'>
            <path d='M6 9l6 6 6-6'></path>
          </svg>
        </button>

        {/* Dropdown */}
        <div
          class='facebook-menu invisible opacity-0 absolute left-0 right-0 z-50 flex flex-col gap-1 corner-squircle rounded-xl border border-white/10 bg-stone-900 p-2 shadow-2xl shadow-[#1877f2]/40 transition-all ease-in-out duration-200
    top-full mt-2
    sm:top-auto sm:bottom-full sm:mt-0 sm:mb-2'>
          {
            facebookPages.map((p) => (
              <a
                href={p.href}
                target='_blank'
                rel='noopener noreferrer'
                class='flex items-center gap-3 rounded-xl px-4 py-3 transition-colors hover:bg-[#1877f2]/15 group/item'>
                <span class='flex size-8 shrink-0 items-center justify-center rounded-full bg-[#1877f2]/15 text-[#1877f2] [&_svg]:size-4'>
                  <FacebookIcon />
                </span>
                <div class='flex flex-col gap-0.5 flex-1 min-w-0'>
                  <span class='text-sm font-semibold text-stone-100 leading-tight group-hover/item:text-[#1877f2] transition-colors'>
                    {p.label}
                  </span>
                  <span class='text-[10px] text-stone-500 truncate'>{p.handle}</span>
                </div>
                <svg
                  class='size-3.5 text-stone-600 transition-all group-hover/item:translate-x-0.5 group-hover/item:text-[#1877f2] shrink-0'
                  viewBox='0 0 24 24'
                  fill='none'
                  stroke='currentColor'
                  stroke-width='2'
                  stroke-linecap='round'
                  stroke-linejoin='round'>
                  <path d='M7 17L17 7M17 7H8M17 7v9' />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      {/* Other socials */}
      {
        socials.map((s) => (
          <a
            href={s.href}
            target='_blank'
            rel='noopener noreferrer'
            class='channel-card group flex items-center gap-4 corner-squircle rounded-xl border border-white/10 bg-white/[0.02]  px-6 py-5 transition-all duration-300 basis-full sm:basis-[calc((100%-1rem)/2)] lg:basis-[calc((100%-2rem)/3)] xl:basis-[calc((100%-3rem)/4)]'
            style={`--social-color: ${s.color};`}>
            <span class='flex size-12 shrink-0 items-center border-[var(--social-color)]/40 justify-center rounded-full border bg-[var(--social-color)]/10 text-[var(--social-color)] transition-colors [&_svg]:size-5'>
              <s.Icon />
            </span>
            <div class='flex flex-col gap-0.5 flex-1 min-w-0'>
              <span class='text-[10px] tracking-[0.3em] uppercase text-stone-500'>{s.name}</span>
              <span class='text-base font-bold text-stone-50 truncate transition-colors group-hover:text-[var(--social-color)]'>
                {s.handle}
              </span>
            </div>
            <svg
              class='size-4 text-stone-500 transition-all group-hover:translate-x-1 group-hover:text-[var(--social-color)] shrink-0'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'>
              <path d='M7 17L17 7M17 7H8M17 7v9' />
            </svg>
          </a>
        ))
      }
    </div>
  </div>

  <script>
    function initFacebookDropdown() {
      const dropdowns = document.querySelectorAll<HTMLElement>('[data-fb-dropdown]');

      dropdowns.forEach((dropdown) => {
        const toggle = dropdown.querySelector<HTMLButtonElement>('.facebook-toggle');
        const menu = dropdown.querySelector<HTMLElement>('.facebook-menu');
        const chevron = dropdown.querySelector<SVGElement>('.facebook-chevron');
        if (!toggle || !menu || !chevron) return;

        let isOpen = false;

        const open = () => {
          isOpen = true;
          menu.classList.remove('invisible', 'opacity-0');
          menu.classList.add('visible', 'opacity-100');
          chevron.style.transform = 'rotate(180deg)';
          toggle.setAttribute('aria-expanded', 'true');
        };

        const close = () => {
          isOpen = false;
          menu.classList.remove('visible', 'opacity-100');
          menu.classList.add('invisible', 'opacity-0');
          chevron.style.transform = 'rotate(0deg)';
          toggle.setAttribute('aria-expanded', 'false');
        };

        toggle.addEventListener('click', (e) => {
          e.stopPropagation();
          isOpen ? close() : open();
        });

        document.addEventListener('click', (e) => {
          if (isOpen && !dropdown.contains(e.target as Node)) close();
        });

        document.addEventListener('keydown', (e) => {
          if (isOpen && e.key === 'Escape') {
            close();
            toggle.focus();
          }
        });
      });
    }

    document.addEventListener('astro:page-load', initFacebookDropdown);
  </script>
</section>
