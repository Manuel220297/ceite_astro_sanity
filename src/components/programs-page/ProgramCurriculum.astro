---
import type { CollectionEntry } from 'astro:content';
import { getSemesterUnits } from '@/lib/utils/getSemesterUnits';
import { getProgramUnits } from '@/lib/utils/getProgramUnits';
import { getProgramDuration } from '@/lib/utils/getProgramDuration';
import clsx from 'clsx';

interface Props {
  program: CollectionEntry<'programs'>;
}

const { program } = Astro.props;

const duration = getProgramDuration(program);
const curriculum = program.data.curriculum.slice(0, duration);
const totalUnits = getProgramUnits(program);

const pad = (n: number) => String(n).padStart(2, '0');
---

<article id='program-curriculum' class='relative w-full overflow-hidden bg-background py-20 md:py-28'>
  {/* Ambient glow */}
  <div class='pointer-events-none absolute top-36 right-1/4 size-[600px] rounded-full bg-accent/[0.05] blur-[140px]'>
  </div>

  {/* Headline */}
  <header class='relative z-10 mx-auto mb-20 max-w-[1600px] px-6 md:px-10'>
    <div class='flex flex-col gap-8 md:flex-row md:items-end md:justify-between'>
      <div>
        <h2 class='font-extrabold tracking-wider text-5xl leading-[0.95] sm:text-6xl md:text-7xl'>
          <span class='block text-stone-50'>{program.data.title}</span>
          <span class='block text-accent'>Curriculum</span>
        </h2>
      </div>

      {/* Stats panel */}
      <div
        class='flex justify-center items-end gap-6 sm:gap-10 rounded-2xl border border-white/10 bg-white/[0.02] backdrop-blur-md px-6 py-5'>
        <div class='flex flex-col'>
          <span class='text-[11px] tracking-[0.25em] uppercase text-stone-400'>Years</span>
          <span class='font-(family-name:--font-tiktok) text-3xl text-stone-50 tabular-nums'>{pad(duration)}</span>
        </div>
        <div class='h-10 w-px bg-stone-700/60'></div>
        <div class='flex flex-col'>
          <span class='text-[11px] tracking-[0.25em] uppercase text-stone-400'>Total Units</span>
          <span class='font-(family-name:--font-tiktok) text-3xl text-stone-50 tabular-nums'>{totalUnits}</span>
        </div>
      </div>
    </div>
  </header>
  <div id='swiper-curriculum-pagination' class='swiper-pagination mb-3'></div>

  {/* Swiper */}
  <div class='relative z-10 mx-auto w-full max-w-[1600px] xl:px-10'>
    <div id='swiper-curriculum' class='swiper relative !overflow-visible'>
      <div class='swiper-wrapper'>
        {
          curriculum.map((c, i) => (
            <div class='swiper-slide !h-auto'>
              <div class='group/card flex h-full flex-col overflow-hidden rounded-2xl border border-white/[0.08] bg-white/[0.015] backdrop-blur-md transition-all duration-300 hover:border-white/[0.15] hover:bg-white/[0.025]'>
                {/* Header Title */}
                <div class='relative flex flex-col gap-1 border-b border-white/[0.06] px-6 pt-6 pb-5'>
                  <div class='swiper-no-swiping flex items-center justify-between'>
                    <h3 class='font-(family-name:--font-tiktok) text-2xl leading-tight text-stone-50'>{c.year}</h3>
                    <span class='font-bold text-[11px] tabular-nums text-accent'>
                      {(getSemesterUnits(c.firstSemester?.subjects) ?? 0) +
                        (getSemesterUnits(c.secondSemester?.subjects) ?? 0)}
                      <span class='ml-1 font-light text-stone-400'>units</span>
                    </span>
                  </div>
                </div>

                {/* Body */}
                <div class='swiper-no-swiping flex flex-1 flex-col divide-y divide-white/[0.05]'>
                  {/* First semester */}
                  {c.firstSemester?.subjects && c.firstSemester.subjects.length > 0 && (
                    <div class='flex flex-col gap-4 px-6 py-5'>
                      <div class='flex items-baseline justify-between'>
                        <div class='flex items-baseline gap-2.5'>
                          <span class='font-mono text-[10px] font-bold tabular-nums text-stone-500'>01</span>
                          <h4 class='text-xs font-semibold tracking-wide text-stone-200'>First Semester</h4>
                        </div>
                        <span class='font-mono text-[10px] font-medium tabular-nums text-stone-300'>
                          <span class='font-extrabold text-accent'>{getSemesterUnits(c.firstSemester?.subjects)}</span>{' '}
                          units
                        </span>
                      </div>

                      <ul class='flex flex-col'>
                        {c.firstSemester.subjects.map((subject) => {
                          const isSpec = subject?.isSpecialization;
                          const specs = program.data.specializations ?? [];

                          return (
                            <li
                              class={clsx(
                                'group/sub relative flex flex-col gap-2 border-b border-stone-200/[0.06] py-3 last:border-b-0 transition-colors',
                                isSpec
                                  ? 'border-l-2 border-l-accent/60 bg-stone-400/[0.1] pl-3 pr-3 mt-2 -mx-3 rounded-r-md'
                                  : 'hover:bg-white/[0.02]',
                              )}>
                              {/* Top row: subject name + units */}
                              <div class='flex items-baseline justify-between gap-3'>
                                <div class='flex min-w-0 flex-1 items-center gap-2'>
                                  {isSpec && (
                                    <span class='shrink-0 font-mono text-[9px] font-bold tracking-[0.2em] uppercase text-accent'>
                                      ♦
                                    </span>
                                  )}
                                  <span class='text-xs sm:text-sm leading-snug text-stone-100'>{subject.subject}</span>
                                </div>
                                <span class='shrink-0 font-mono text-[11px] tabular-nums text-stone-400'>
                                  {subject.units}
                                </span>
                              </div>

                              {/* Specialization tracks — shown ONLY for specialization rows */}
                              {isSpec && specs.length > 0 && (
                                <div class='flex flex-wrap items-center gap-x-1.5 gap-y-1'>
                                  <span class='text-[9px] sm:text-[10px] font-medium tracking-[0.15em] uppercase text-stone-500 w-full'>
                                    Specialization:
                                  </span>

                                  {specs.map((s) => (
                                    <span
                                      class='inline-flex items-center gap-1 sm:gap-1.5 rounded-full border px-1.5 py-0.5 sm:px-2 text-[9px] sm:text-[10px] font-semibold tracking-wide whitespace-nowrap'
                                      style={`border-color: rgb(from ${s.color} r g b / 0.4); background-color: rgb(from ${s.color} r g b / 0.1); color: ${s.color};`}>
                                      <span
                                        class='size-1 shrink-0 rounded-full'
                                        style={`background-color: ${s.color};`}
                                      />
                                      {s.specialization}
                                    </span>
                                  ))}
                                </div>
                              )}
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  )}

                  {/* Second semester */}
                  {c.secondSemester?.subjects && c.secondSemester.subjects.length > 0 && (
                    <div class='flex flex-col gap-4 px-6 py-5'>
                      <div class='flex items-baseline justify-between'>
                        <div class='flex items-baseline gap-2.5'>
                          <span class='font-mono text-[10px] font-bold tabular-nums text-stone-500'>02</span>
                          <h4 class='text-xs font-semibold tracking-wide text-stone-200'>Second Semester</h4>
                        </div>
                        <span class='font-mono text-[10px] font-medium tabular-nums text-stone-300'>
                          <span class='font-extrabold text-accent'>{getSemesterUnits(c.secondSemester?.subjects)}</span>{' '}
                          units
                        </span>
                      </div>

                      <ul class='flex flex-col'>
                        {c.secondSemester?.subjects?.map((subject) => {
                          const isSpec = subject?.isSpecialization;
                          const specs = program.data.specializations ?? [];

                          return (
                            <li
                              class={clsx(
                                'group/sub relative flex flex-col gap-2 border-b border-stone-200/[0.06] py-3 last:border-b-0 transition-colors',
                                isSpec
                                  ? 'border-l-2 border-l-accent/60 bg-stone-400/[0.1] pl-3 pr-3 mt-2 -mx-3 rounded-r-md'
                                  : 'hover:bg-white/[0.02]',
                              )}>
                              {/* Top row: subject name + units */}
                              <div class='flex items-baseline justify-between gap-3'>
                                <div class='flex min-w-0 flex-1 items-center gap-2'>
                                  {isSpec && (
                                    <span class='shrink-0 font-mono text-[9px] font-bold tracking-[0.2em] uppercase text-accent'>
                                      ♦
                                    </span>
                                  )}
                                  <span class='text-xs sm:text-sm leading-snug text-stone-100'>{subject.subject}</span>
                                </div>
                                <span class='shrink-0 font-mono text-[11px] tabular-nums text-stone-400'>
                                  {subject.units}
                                </span>
                              </div>

                              {/* Specialization tracks — shown ONLY for specialization rows */}
                              {isSpec && specs.length > 0 && (
                                <div class='flex flex-wrap items-center gap-x-1.5 gap-y-1'>
                                  <span class='text-[9px] sm:text-[10px] font-medium tracking-[0.15em] uppercase text-stone-500 w-full'>
                                    Specialization:
                                  </span>
                                  {specs.map((s) => (
                                    <span
                                      class='inline-flex items-center gap-1 sm:gap-1.5 rounded-full border px-1.5 py-0.5 sm:px-2 text-[9px] sm:text-[10px] font-semibold tracking-wide whitespace-nowrap'
                                      style={`border-color: rgb(from ${s.color} r g b / 0.4); background-color: rgb(from ${s.color} r g b / 0.1); color: ${s.color};`}>
                                      <span
                                        class='size-1 shrink-0 rounded-full'
                                        style={`background-color: ${s.color};`}
                                      />
                                      {s.specialization}
                                    </span>
                                  ))}
                                </div>
                              )}
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</article>

<script>
  import Swiper from 'swiper';
  import { Keyboard, Pagination } from 'swiper/modules';

  let swiperInstance: Swiper | null = null;

  function initCurriculumSwiper() {
    const el = document.querySelector('#swiper-curriculum');
    if (!el) return;

    if (swiperInstance) {
      swiperInstance.destroy(true, true);
      swiperInstance = null;
    }

    swiperInstance = new Swiper('#swiper-curriculum', {
      modules: [Keyboard, Pagination],
      slidesPerView: 1.25,
      spaceBetween: 20,
      speed: 400,
      cssMode: true,
      pagination: {
        el: '#swiper-curriculum-pagination',
        clickable: true,
      },
      centeredSlides: true,
      breakpoints: {
        640: { slidesPerView: 2.33, centeredSlides: false },
        1024: { slidesPerView: 3.33, centeredSlides: false },
        1280: { slidesPerView: 4, centeredSlides: false },
      },
    });
  }

  document.addEventListener('astro:page-load', initCurriculumSwiper);

  document.addEventListener('astro:before-swap', () => {
    if (swiperInstance) {
      swiperInstance.destroy(true, true);
      swiperInstance = null;
    }
  });
</script>
