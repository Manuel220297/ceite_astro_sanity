---
import type { CollectionEntry } from 'astro:content';

interface Props {
  program: CollectionEntry<'programs'>;
}

const { program } = Astro.props;

const duration =
  program.data.curriculum.findLastIndex(
    (year) => (year.firstSemester?.subjects?.length ?? 0) > 0 || (year.secondSemester?.subjects?.length ?? 0) > 0,
  ) + 1;

// cuts curriculum years depending on duration
const curriculum = program.data.curriculum.slice(0, duration);
---

<article id='program-curriculum'>
  <h2 class='text-4xl font-bold tracking-tight mb-8'>
    {program.data.title}
    <span class='text-accent]'>CURRICULUM</span>
  </h2>

  <div class='flex flex-row xl:justify-center gap-6 overflow-x-auto pb-4'>
    {
      curriculum.map((c) => (
        <div class='shrink-0 w-80 border border-white/10 bg-white/[0.02] p-6'>
          <h3 class='text-lg font-bold tracking-wide mb-6'>{c.year}</h3>

          <div class='flex flex-col gap-6'>
            <div>
              <h4 class='text-xs flex justify-between font-semibold uppercase tracking-wider text-accent mb-3'>
                1st Semester <span class='text-neutral-400'>{c.firstSemester?.units} units</span>
              </h4>
              <div class='flex flex-col gap-2'>
                {c.firstSemester?.subjects?.map((subject) => (
                  <div
                    class='flex items-start gap-2 border-l-2 border-accent bg-white/[0.03] py-2 pl-3 pr-3'
                    style={
                      subject.specialization?.color
                        ? `background-color: ${subject.specialization.color}26; border-left-color: ${subject.specialization.color};`
                        : ''
                    }>
                    <span
                      class='text-sm leading-snug text-neutral-300'
                      style={subject.specialization?.color ? `color: ${subject.specialization.color}` : ''}>
                      • {subject.subject}
                      {subject.specialization?.specialization && (
                        <span class='block mt-2 font-extrabold'>{subject.specialization.specialization}</span>
                      )}
                    </span>
                  </div>
                ))}
              </div>
            </div>

            {c.secondSemester?.subjects && c.secondSemester.subjects.length > 0 && (
              <div>
                <h4 class='text-xs flex justify-between font-semibold uppercase tracking-wider text-[var(--color-accent)] mb-3'>
                  2nd Semester <span class='text-neutral-400'>{c.secondSemester?.units} units</span>
                </h4>
                <div class='flex flex-col gap-2'>
                  {c.secondSemester.subjects.map((subject) => (
                    <div
                      class='flex items-start gap-2 border-l-2 border-[var(--color-accent)] bg-white/[0.03] py-2 pl-3 pr-3'
                      style={
                        subject.specialization?.color
                          ? `background-color: ${subject.specialization.color}26; border-left-color: ${subject.specialization.color};`
                          : ''
                      }>
                      <span
                        class='text-sm leading-snug text-neutral-300 '
                        style={subject.specialization?.color ? `color: ${subject.specialization.color}` : ''}>
                        • {subject.subject}
                        {subject.specialization?.specialization && (
                          <span class='block mt-2 font-extrabold'>{subject.specialization.specialization}</span>
                        )}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>
</article>
