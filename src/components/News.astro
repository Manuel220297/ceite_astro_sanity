---
import { getCollection } from 'astro:content';
import SanityImage from './SanityImage.astro';
import { PortableText } from 'astro-portabletext';

const news = (await getCollection('sanityNews')).sort(
  (a, b) => b.data._createdAt.getTime() - a.data._createdAt.getTime(),
);
const latestNews = news[0];
const olderNews = news.slice(1, 4);

const pad = (n: number) => String(n).padStart(2, '0');

function timeAgo(dateString: string) {
  const now = new Date().getTime();
  const past = new Date(dateString).getTime();

  const diffMs = now - past;
  const diffMins = Math.floor(diffMs / (1000 * 60));
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

  const years = Math.floor(diffDays / 365);
  const months = Math.floor((diffDays % 365) / 30);
  const days = diffDays % 30;
  const hours = diffHours % 24;
  const mins = diffMins % 60;

  if (years > 0) return `${years} year${years > 1 ? 's' : ''} ago`;
  if (months > 0) return `${months} month${months > 1 ? 's' : ''} ago`;
  if (days > 0) return `${days} day${days > 1 ? 's' : ''} ago`;
  if (hours > 0) return `${hours} hour${hours > 1 ? 's' : ''} ago`;
  return `${mins} minute${mins !== 1 ? 's' : ''} ago`;
}

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
}
---

<section class='relative w-full overflow-hidden bg-background py-20 md:py-28'>
  {/* Ambient accent glow */}
  <div class='pointer-events-none absolute top-0 right-1/4 size-[600px] rounded-full bg-accent/[0.04] blur-[140px]'>
  </div>

  {/* Top meta bar */}
  <div
    class='relative z-10 mx-auto mb-10 flex w-full max-w-[1600px] items-center gap-4 px-6 md:px-10 text-[10px] md:text-xs tracking-[0.25em] text-stone-500'>
    <span class='flex items-center gap-2'>
      <span class='relative inline-block size-1.5 rounded-full bg-accent'>
        <span class='absolute inset-0 animate-ping rounded-full bg-accent/70'></span>
      </span>
      <span class='uppercase text-stone-300'>CEITE</span>
      <span class='text-stone-600'>/</span>
      <span class='uppercase'>News</span>
    </span>
    <span class='h-px flex-1 bg-linear-to-r from-stone-700/80 via-stone-700/30 to-transparent'></span>
  </div>

  {/* Headline */}
  <header class='relative z-10 mx-auto mb-16 max-w-[1600px] px-6 md:px-10'>
    <div class='flex flex-col gap-6 md:flex-row md:items-end md:justify-between'>
      <h1 class='text-5xl leading-[0.95] tracking-wider font-extrabold sm:text-6xl md:text-7xl lg:text-8xl'>
        <span class='block text-stone-50'>News &</span>
        <span class='block text-accent'>Happenings</span>
      </h1>
      <p class='max-w-md text-sm leading-relaxed text-stone-400 sm:text-base md:text-right'>
        Stay updated with the happenings in the School
      </p>
    </div>
  </header>

  {/* Main grid */}
  <div class='relative z-10 mx-auto grid w-full max-w-[1600px] gap-8 px-6 md:px-10 lg:grid-cols-3 lg:gap-10'>
    {/* ─── Featured story ─── */}
    <article class='group relative lg:col-span-2'>
      <a href={`/news/${latestNews.data.slug}`} class='block'>
        <div class='relative overflow-hidden rounded-2xl sm:rounded-[32px] border border-white/10 bg-white/[0.02]'>
          {/* Image */}
          <div class='relative overflow-hidden rounded-2xl sm:rounded-[32px]'>
            <SanityImage
              width={1366}
              height={768}
              loading='lazy'
              image={latestNews.data.image}
              class='aspect-[4/3] sm:aspect-[16/10] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]'
            />
            {/* Gradient layers — only on sm+ where content overlays the image */}
            <div
              class='pointer-events-none absolute inset-0 hidden sm:block bg-linear-to-t from-background via-background/40 via-30% to-transparent'>
            </div>
            <div class='pointer-events-none absolute inset-0 hidden sm:block bg-black/40'></div>
            {/* Mobile gradient — only fades top so badge is readable */}
            <div
              class='pointer-events-none absolute inset-0 sm:hidden bg-linear-to-b from-background/60 via-transparent to-transparent'>
            </div>
          </div>

          {/* Featured badge — top left */}
          <div
            class='absolute left-4 top-4 flex items-center gap-2 rounded-full border border-white/15 bg-black/50 px-3 py-1 backdrop-blur-md sm:left-8 sm:top-8 sm:gap-3 sm:px-4 sm:py-1.5'>
            <span class='relative inline-block size-1.5 rounded-full bg-accent'>
              <span class='absolute inset-0 animate-ping rounded-full bg-accent/70'></span>
            </span>
            <span class='text-[9px] sm:text-[10px] tracking-[0.25em] sm:tracking-[0.3em] uppercase text-stone-100'
              >Latest</span
            >
          </div>

          {/* Date pill — top right, sm+ only */}
          <div
            class='absolute right-5 top-5 hidden sm:flex items-center gap-2 rounded-full border border-white/10 bg-black/30 px-4 py-1.5 backdrop-blur-md sm:right-8 sm:top-8'>
            <svg
              class='size-3 text-stone-300'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'>
              <rect x='3' y='4' width='18' height='18' rx='2'></rect>
              <path d='M16 2v4M8 2v4M3 10h18'></path>
            </svg>
            <time
              datetime={latestNews.data._createdAt.toLocaleDateString('en-ca')}
              class='text-[10px] tracking-[0.25em] uppercase text-stone-200 tabular-nums'>
              {formatDate(latestNews.data._createdAt)}
            </time>
          </div>

          {/* Content — STACKED on mobile, OVERLAY on sm+ */}
          <div class='relative p-5 sm:absolute sm:inset-x-0 sm:bottom-0 sm:p-10 lg:p-12'>
            <div class='mb-4 flex flex-wrap items-center gap-2 sm:mb-5 sm:gap-3'>
              <span
                class='rounded-full border border-accent/40 bg-accent/15 px-2.5 py-1 text-[9px] sm:text-[10px] font-bold tracking-[0.25em] uppercase text-accent backdrop-blur-md'>
                {latestNews.data.category}
              </span>
              <span class='h-px w-6 sm:w-8 bg-stone-500/60'></span>
              <span class='text-[9px] sm:text-[10px] tracking-[0.25em] uppercase text-stone-400'>
                {timeAgo(latestNews.data._createdAt.toString())}
              </span>
            </div>

            <h2
              class='font-(family-name:--font-tiktok) text-2xl leading-[1.1] text-stone-50 sm:text-4xl sm:leading-[1.05] lg:text-5xl sm:drop-shadow-[0_4px_30px_rgba(0,0,0,0.6)]'>
              <span
                class='bg-linear-to-r from-accent to-accent bg-[length:0%_2px] bg-left-bottom bg-no-repeat transition-[background-size] duration-500 group-hover:bg-[length:100%_2px]'>
                {latestNews.data.title}
              </span>
            </h2>

            <div class='mt-3 line-clamp-2 max-w-2xl text-sm leading-relaxed text-stone-300 sm:mt-4 sm:text-base'>
              <PortableText value={latestNews.data.body} />
            </div>

            {/* CTA */}
            <div
              class='mt-5 inline-flex items-center gap-2 text-[11px] sm:text-xs font-semibold tracking-[0.2em] uppercase text-accent transition-all group-hover:gap-3 sm:mt-6'>
              <span>Read story</span>
              <svg
                class='size-4 transition-transform group-hover:translate-x-1'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='2'
                stroke-linecap='round'
                stroke-linejoin='round'>
                <path d='M5 12h14M13 5l7 7-7 7'></path>
              </svg>
            </div>
          </div>
        </div>
      </a>
    </article>

    {/* ─── Older News ─── */}
    <aside class='lg:col-span-1'>
      {/* Sidebar header */}
      <div class='mb-6 flex items-center gap-3'>
        <span class='h-px w-6 bg-accent'></span>
        <span class='text-[10px] tracking-[0.3em] uppercase text-stone-500'>·</span>
        <span class='text-[10px] tracking-[0.3em] uppercase text-stone-400'>More Stories</span>
      </div>

      <ul class='flex flex-col gap-3'>
        {
          olderNews.map((n, i) => (
            <li>
              <a
                href={`/news/${n.data.slug}`}
                class='news-row group relative flex gap-4 overflow-hidden rounded-2xl border border-white/5 bg-white/[0.02] p-4 transition-all duration-500 hover:border-accent/30 hover:bg-white/[0.04]'>
                {/* Number */}

                {/* Image */}
                <div class='relative size-24 shrink-0 overflow-hidden rounded-xl bg-white/5'>
                  <SanityImage
                    width={256}
                    height={256}
                    loading='lazy'
                    image={n.data.image}
                    class='size-full object-cover saturate-[0.85] transition-all duration-500 group-hover:scale-110 group-hover:saturate-100'
                  />
                  <div class='pointer-events-none absolute inset-0 bg-linear-to-tr from-background/30 to-transparent' />
                </div>

                {/* Text */}
                <div class='flex min-w-0 flex-1 flex-col justify-between pr-6'>
                  <div>
                    <div class='mb-1.5 flex items-center gap-2'>
                      <span class='text-[9px] font-bold tracking-[0.25em] uppercase text-accent'>
                        {n.data.category}
                      </span>
                      <span class='size-1 rounded-full bg-stone-600' />
                      <time
                        datetime={n.data._createdAt.toLocaleDateString('en-ca')}
                        class='text-[9px] tracking-[0.2em] uppercase text-stone-500'>
                        {timeAgo(n.data._createdAt.toString())}
                      </time>
                    </div>

                    <h4 class='line-clamp-2 text-sm font-semibold leading-snug text-stone-100 transition-colors group-hover:text-accent'>
                      {n.data.title}
                    </h4>

                    <div class='mt-1 line-clamp-1 text-xs leading-relaxed text-stone-500'>
                      <PortableText value={n.data.body} />
                    </div>
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>

      {/* View all link */}
      <span
        class='view-all group mt-5 flex w-full items-center justify-between rounded-2xl border border-white/10 bg-white/[0.02] px-5 py-4 text-xs font-semibold tracking-[0.2em] uppercase text-stone-300 transition-all hover:border-accent/40 hover:bg-accent/5 hover:text-accent cursor-pointer'>
        <span>View all stories</span>
        <span class='flex items-center gap-2'>
          <span class='tabular-nums text-stone-500 group-hover:text-accent/70'>{pad(news.length)}</span>
          <svg
            class='size-4 transition-transform group-hover:translate-x-1'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'>
            <path d='M5 12h14M13 5l7 7-7 7'></path>
          </svg>
        </span>
      </span>
    </aside>
  </div>
</section>
