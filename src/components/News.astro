---
import { getCollection } from 'astro:content';
import SanityImage from './SanityImage.astro';
import { PortableText } from 'astro-portabletext';

const news = (await getCollection('sanityNews')).sort(
  (a, b) => b.data._createdAt.getTime() - a.data._createdAt.getTime(),
);
const latestNews = news[0];
const olderNews = news.slice(1, 4);

function timeAgo(dateString: string) {
  const now = new Date().getTime();
  const past = new Date(dateString).getTime();

  const diffMs = now - past;
  const diffMins = Math.floor(diffMs / (1000 * 60));
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

  const years = Math.floor(diffDays / 365);
  const months = Math.floor((diffDays % 365) / 30);
  const days = diffDays % 30;
  const hours = diffHours % 24;
  const mins = diffMins % 60;

  if (years > 0) {
    return `${years} year${years > 1 ? 's' : ''} ago`;
  }

  if (months > 0) {
    return `${months} month${months > 1 ? 's' : ''} ago`;
  }

  if (days > 0) {
    return `${days} day${days > 1 ? 's' : ''} ago`;
  }

  if (hours > 0) {
    return `${hours} hour${hours > 1 ? 's' : ''} ago`;
  }

  return `${mins} minute${mins !== 1 ? 's' : ''} ago`;
}
---

<section class='mx-auto grid max-w-7xl gap-8 px-4 py-12 lg:grid-cols-3 lg:gap-12'>
  {/* ─── Featured story ─── */}
  <article class='group relative lg:col-span-2'>
    <a href={`/news/${latestNews.data.slug}`} class='block'>
      <div class='relative overflow-hidden rounded-2xl bg-neutral-100'>
        <SanityImage
          width={1366}
          height={768}
          image={latestNews.data.image}
          class='aspect-[16/10] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]'
        />
        <div class='absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent'></div>

        <div class='absolute inset-x-0 bottom-0 p-6 sm:p-8 lg:p-10'>
          <div class='mb-4 flex items-center gap-3 text-xs font-medium uppercase tracking-[0.2em] text-white/90'>
            <span class='rounded-full bg-white/15 px-3 py-1 backdrop-blur-sm ring-1 ring-white/20'>
              {latestNews.data.category}
            </span>
            <span class='h-px w-6 bg-white/40'></span>
            <time datetime={latestNews.data._createdAt.toLocaleDateString('en-ca')}
              >{timeAgo(latestNews.data._createdAt.toString())}</time
            >
          </div>

          <h2 class='text-3xl' leading-tight text-white sm:text-4xl lg:text-5xl'>
            <span
              class='bg-gradient-to-r from-white to-white bg-[length:0%_2px] bg-left-bottom bg-no-repeat transition-[background-size] duration-500 group-hover:bg-[length:100%_2px]'>
              {latestNews.data.title}
            </span>
          </h2>

          <div class='mt-4 line-clamp-2 max-w-2xl text-base text-white/80 sm:text-lg'>
            <PortableText value={latestNews.data.body} />
          </div>
        </div>
      </div>
    </a>
  </article>

  {/* ─── Older stories sidebar ─── */}
  <aside class='lg:col-span-1'>
    <div class='mb-6 flex items-baseline justify-between border-b border-white/15 pb-3'>
      <h3 class='text-xl' tracking-tight text-white'>More Stories</h3>
      <span class='text-[11px] font-medium uppercase tracking-[0.2em] text-white/50'> Latest </span>
    </div>

    <ul class='divide-y divide-white/10'>
      {
        olderNews.map((n) => (
          <li>
            <a href={`/news/${n.data.slug}`} class='group flex gap-4 py-5'>
              <div class='relative h-20 w-20 flex-none overflow-hidden rounded-lg bg-white/5'>
                <SanityImage
                  width={256}
                  height={256}
                  image={n.data.image}
                  class='h-full w-full object-cover transition-transform duration-500 group-hover:scale-110'
                />
              </div>

              <div class='min-w-0 flex-1'>
                <div class='mb-1.5 flex items-center gap-2 text-[10px] font-medium uppercase tracking-[0.18em] text-white/50'>
                  <span class='text-white/80'>{n.data.category}</span>
                  <span class='h-1 w-1 rounded-full bg-white/30' />
                  <time datetime={n.data._createdAt.toLocaleDateString('en-ca')}>
                    {timeAgo(n.data._createdAt.toString())}
                  </time>
                </div>

                <h4 class='line-clamp-2 text-base leading-snug text-white transition-colors group-hover:text-white/70'>
                  {n.data.title}
                </h4>

                <div class='mt-1.5 line-clamp-2 text-xs leading-relaxed text-white/50'>
                  <PortableText value={n.data.body} />
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </aside>
</section>
