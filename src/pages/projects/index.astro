---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import SanityImage from '../../components/SanityImage.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const projects = await getCollection('projects');

// Unique programs for filter
const programs = Array.from(
  new Map(projects.filter((p) => p.data.program).map((p) => [p.data.program!.slug, p.data.program!])).values(),
);

const pad = (n: number) => String(n).padStart(2, '0');
---

<MainLayout>
  <section class='relative w-full overflow-hidden bg-background py-24 md:py-32'>
    <div
      class='pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 size-[800px] rounded-full bg-accent/[0.04] blur-[140px]'>
    </div>
    <div class='pointer-events-none absolute inset-0 opacity-[1] pattern-circuit'></div>

    <Breadcrumb
      class='mb-12'
      tail={`${pad(projects.length)} Projects`}
      items={[
        { label: 'CEITE', href: '/' },
        { label: 'Projects', href: '/projects' },
      ]}
    />

    <header class='relative z-10 mx-auto mb-14 max-w-[1600px] px-6 md:px-10'>
      <div class='flex flex-col gap-8 md:flex-row md:items-end md:justify-between'>
        <div>
          <div class='mb-4 flex items-center gap-3'>
            <span class='h-px w-8 bg-accent'></span>
            <span class='text-[10px] tracking-[0.3em] uppercase text-accent'>Student Works</span>
          </div>
          <h1 class='font-(family-name:--font-tiktok) text-5xl leading-[0.95] sm:text-6xl md:text-7xl lg:text-8xl'>
            <span class='block text-stone-50'>Project</span>
            <span class='block text-accent'>Showcase</span>
          </h1>
          <p class='mt-5 max-w-md text-sm leading-relaxed text-stone-400 sm:text-base'>
            Capstone projects, research, and prototypes built by students across the College of Engineering &amp;
            Information Technology Education.
          </p>
        </div>
      </div>
    </header>

    {
      programs.length > 0 && (
        <div class='relative z-10 mx-auto mb-10 w-full max-w-[1600px] px-6 md:px-10'>
          <div class='flex items-center gap-3 mb-4'>
            <span class='h-px w-6 bg-accent' />
            <span class='text-[10px] tracking-[0.3em] uppercase text-stone-500'>Filter by Program</span>
          </div>
          <div class='flex flex-wrap gap-2'>
            <span
              class='filter-chip is-active flex items-center gap-2 rounded-full border border-white/10 bg-background px-4 py-1.5 text-xs font-medium text-stone-300 cursor-pointer transition-all hover:border-accent/40 hover:bg-accent/10 hover:text-accent'
              data-program='all'>
              <span class='size-1.5 rounded-full bg-accent' />
              <span>All Projects</span>
              <span class='chip-count tabular-nums text-stone-500'>{pad(projects.length)}</span>
            </span>
            {programs.map((program) => {
              const count = projects.filter((p) => p.data.program?.slug === program.slug).length;
              return (
                <span
                  class='filter-chip flex items-center gap-2 rounded-full border border-white/10 bg-background px-4 py-1.5 text-xs font-medium text-stone-300 cursor-pointer transition-all hover:border-accent/40 hover:bg-accent/10 hover:text-accent'
                  data-program={program.slug}>
                  <span>{program.title}</span>
                  <span class='chip-count tabular-nums text-stone-500'>{pad(count)}</span>
                </span>
              );
            })}
          </div>
        </div>
      )
    }

    {/* Projects grid */}
    <div class='relative z-10 mx-auto w-full max-w-[1600px] px-6 md:px-10'>
      <div class='mb-6 flex items-center gap-3'>
        <span class='h-px w-6 bg-accent'></span>
        <span class='text-[10px] tracking-[0.3em] uppercase text-accent'>All</span>
        <span class='text-[10px] tracking-[0.3em] uppercase text-stone-500'>·</span>
        <span class='text-[10px] tracking-[0.3em] uppercase text-stone-400'>Student Projects</span>
      </div>

      <div class='flex flex-wrap gap-6'>
        {
          projects.map((p, i) => (
            <article
              class='project-card group relative flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-background transition-all duration-500 hover:border-accent/30 basis-full sm:basis-[calc((100%-1.5rem)/2)] lg:basis-[calc((100%-3rem)/3)]'
              data-program={p.data.program?.slug ?? 'none'}
              style={`--row-index: ${i}`}>
              <a href={`/projects/${p.data.slug}`} class='flex h-full flex-col'>
                {/* Image */}
                <div class='relative aspect-[4/3] overflow-hidden'>
                  <SanityImage
                    width={1024}
                    height={576}
                    image={p.data.image}
                    fallback='/images/default_background.avif'
                    loading={i < 6 ? 'eager' : 'lazy'}
                    class='size-full object-cover saturate-[0.9] transition-all duration-700 group-hover:scale-105 group-hover:saturate-100'
                  />
                  <div class='pointer-events-none absolute inset-0 bg-linear-to-t from-background/80 via-background/20 to-transparent' />

                  {/* Top-left: index number */}
                  <span class='absolute left-4 top-4 font-(family-name:--font-tiktok) text-base tabular-nums text-stone-300/70'>
                    {pad(i + 1)}
                  </span>

                  {/* Top-right: program badge */}
                  {p.data.program && (
                    <div class='flex flex-col justify-center items-center absolute right-4 top-4 rounded-xl corner-squircle border border-stone-600 group-hover:border-accent/67  bg-background/50 backdrop-blur-sm p-2'>
                      <SanityImage
                        class='size-[clamp(24px,4vw,48px)]'
                        image={p.data.program.logo}
                        fallback='/images/asiatech_logo.avif'
                        format='none'
                        width={128}
                        height={128}
                        loading='lazy'
                      />
                      <span class='text-xs text-stone-100 group-hover:text-accent font-bold'>
                        {p.data.program.title}
                      </span>
                    </div>
                  )}
                </div>

                {/* Body */}
                <div class='flex flex-1 flex-col gap-2 p-5'>
                  {/* Title */}
                  <h2 class='text-lg font-bold leading-[1.15] line-clamp-2 text-stone-50 transition-colors group-hover:text-accent'>
                    {p.data.title}
                  </h2>

                  {/* Author */}
                  {p.data.author && (
                    <div class='flex items-center gap-2 text-xs text-stone-400'>
                      <svg
                        class='size-3 shrink-0 text-stone-500'
                        viewBox='0 0 24 24'
                        fill='none'
                        stroke='currentColor'
                        stroke-width='2'
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        aria-hidden='true'>
                        <path d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2' />
                        <circle cx='12' cy='7' r='4' />
                      </svg>
                      <span class='line-clamp-1'>by {p.data.author}</span>
                    </div>
                  )}

                  {/* Footer CTA */}
                  <div class='mt-auto flex items-center gap-2 pt-3 text-[10px] font-semibold tracking-[0.25em] uppercase text-stone-400 transition-all group-hover:text-accent group-hover:gap-3'>
                    <span>View project</span>
                    <svg
                      class='size-3.5 transition-transform group-hover:translate-x-1'
                      viewBox='0 0 24 24'
                      fill='none'
                      stroke='currentColor'
                      stroke-width='2'
                      stroke-linecap='round'
                      stroke-linejoin='round'>
                      <path d='M5 12h14M13 5l7 7-7 7' />
                    </svg>
                  </div>
                </div>
              </a>
            </article>
          ))
        }
      </div>

      <div id='empty-state' class='hidden flex-col items-center gap-3 py-20 text-center'>
        <span class='text-[10px] tracking-[0.3em] uppercase text-stone-500'>No Projects Found</span>
        <p class='text-stone-400'>Try selecting a different program.</p>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  function initProjectFilter() {
    const chips = document.querySelectorAll<HTMLElement>('.filter-chip');
    const cards = document.querySelectorAll<HTMLElement>('.project-card');
    const emptyState = document.getElementById('empty-state');

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const target = chip.dataset.program;

        chips.forEach((c) => c.classList.remove('is-active'));
        chip.classList.add('is-active');

        let visibleCount = 0;
        cards.forEach((card) => {
          const match = target === 'all' || card.dataset.program === target;
          card.style.display = match ? '' : 'none';
          if (match) visibleCount++;
        });

        if (emptyState) {
          emptyState.classList.toggle('hidden', visibleCount > 0);
          emptyState.classList.toggle('flex', visibleCount === 0);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initProjectFilter);
</script>
