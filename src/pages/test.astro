---
import MainLayout from '@/layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
const news = await getCollection('news');
const filteredNews = news.filter((n) => n.data.pin ?? false);

console.log(filteredNews.map((n) => n.data.title));
---

<MainLayout>
  <section class='mt-24'>
    <h1 class='text-4xl font-bold'>Pinned News</h1>
    {filteredNews.map((n) => <h3 class='text-xl'>{n.data.title} </h3>)}
  </section>
  <div class='flex justify-center items-center'>
    <div class='custom-button'>About ↓</div>
  </div>
</MainLayout>
