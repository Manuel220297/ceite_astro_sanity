---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import SanityImage from '../components/SanityImage.astro';
import SocialIcon from '../components/SocialIcon.astro';

const [dean] = await getCollection('dean');
const faculty = await getCollection('faculty');

const pad = (n: number) => String(n).padStart(2, '0');

// Helper: build full name with honorifics + first + middle + last
function fullName(data: any) {
  return [data.honorifics, data.firstName, data.middleName, data.lastName].filter(Boolean).join(' ');
}

// Social link helper — excludes email (handled separately)
const socialLinks = (data: any) =>
  [
    { key: 'facebook', value: data.facebook, href: data.facebook, label: 'Facebook' },
    { key: 'tiktok', value: data.tiktok, href: data.tiktok, label: 'TikTok' },
    { key: 'twitter', value: data.twitter, href: data.twitter, label: 'X' },
    { key: 'instagram', value: data.instagram, href: data.instagram, label: 'Instagram' },
  ].filter((s) => s.value);
---

<MainLayout>
  <section class='relative w-full overflow-hidden bg-background pt-32 pb-24 md:pt-40 md:pb-32'>
    {/* Ambient background glow */}
    <div
      class='pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 size-[800px] rounded-full bg-accent/5 blur-[120px]'>
    </div>

    {/* Top meta bar */}
    <div
      class='relative z-10 mx-auto mb-12 flex w-full max-w-[1600px] items-center gap-4 px-6 md:px-10 text-[10px] md:text-xs tracking-[0.25em] text-stone-500'>
      <span class='flex items-center gap-2'>
        <span class='relative inline-block size-1.5 rounded-full bg-accent'>
          <span class='absolute inset-0 animate-ping rounded-full bg-accent/70'></span>
        </span>
        <span class='uppercase text-stone-300'>CEITE</span>
        <span class='text-stone-600'>/</span>
        <span class='uppercase'>Faculty</span>
      </span>
      <span class='h-px flex-1 bg-linear-to-r from-stone-700/80 via-stone-700/30 to-transparent'></span>
      <span class='uppercase tabular-nums'>{pad(faculty.length + 1)} Members</span>
    </div>

    {/* Headline */}
    <header class='relative z-10 mx-auto max-w-4xl px-6 text-center'>
      <h1 class='font-(family-name:--font-tiktok) tracking-wider text-5xl sm:text-6xl md:text-7xl lg:text-8xl'>
        <span class='block text-stone-50'>C.E.I.T.E</span>
        <span class='block text-accent'>FACULTY</span>
      </h1>
      <p class='mx-auto mt-6 max-w-xl text-sm leading-relaxed text-stone-400 sm:text-base'>
        Meet the educators, mentors, and administrators shaping the next generation of engineers and IT professionals.
      </p>
    </header>

    {/* Dean — featured card */}
    <div class='relative z-10 mx-auto mt-20 w-full max-w-[1400px] px-6 md:px-10'>
      <div class='mb-6 flex items-center gap-3 text-[10px] tracking-[0.3em] uppercase text-stone-500'>
        <span class='h-px w-8 bg-accent'></span>
        <span class='text-accent'>01</span>
        <span>·</span>
        <span>Office of the Dean</span>
      </div>

      <article
        class='dean-card group relative overflow-hidden rounded-[40px] border border-white/10 bg-white/[0.02] backdrop-blur-md'>
        {/* Soft accent glow */}
        <div class='pointer-events-none absolute -right-20 -top-20 size-96 rounded-full bg-accent/10 blur-3xl'></div>

        <div class='grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] gap-0 md:gap-8'>
          {/* Portrait */}
          <div class='relative aspect-square overflow-hidden md:aspect-auto md:min-h-[520px]'>
            <SanityImage
              image={dean.data?.image}
              fallback='/images/default_avatar.svg'
              width={800}
              height={800}
              class='size-full object-cover transition-transform duration-700 group-hover:scale-102'
            />
            <div
              class='absolute inset-0 bg-linear-to-t from-background/80 via-background/10 to-transparent md:bg-linear-to-r md:from-transparent md:to-background/30'>
            </div>
          </div>

          {/* Info */}
          <div class='flex flex-col justify-center gap-6 p-8 md:p-12'>
            <div>
              <span class='text-[10px] tracking-[0.3em] uppercase text-stone-500'>Office of the Dean</span>
              <h2
                class='mt-3 font-(family-name:--font-tiktok) text-3xl leading-tight text-stone-50 sm:text-4xl md:text-5xl'>
                {fullName(dean.data)}
              </h2>
            </div>

            {/* Email — separate from socials */}
            {
              dean.data.email && (
                <div class='flex flex-col gap-2'>
                  <span class='text-[10px] tracking-[0.3em] uppercase text-stone-500'>Email</span>
                  <a
                    href={`mailto:${dean.data.email}`}
                    class='group/email inline-flex w-fit items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-3 text-sm text-stone-200 backdrop-blur-md transition-all hover:border-accent/50 hover:bg-accent/10 hover:text-accent'>
                    <span class='flex size-8 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 text-accent transition-colors group-hover/email:bg-accent/20'>
                      <SocialIcon name='email' />
                    </span>
                    <span class='break-all font-medium tracking-wide'>{dean.data.email}</span>
                  </a>
                </div>
              )
            }

            {/* Socials */}
            {
              socialLinks(dean.data).length > 0 && (
                <div class='flex flex-col gap-3'>
                  <span class='text-[10px] tracking-[0.3em] uppercase text-stone-500'>Official Accounts</span>
                  <div class='flex flex-wrap gap-2'>
                    {socialLinks(dean.data).map((s) => (
                      <a
                        href={s.href}
                        target='_blank'
                        rel='noopener noreferrer'
                        class='social-link group/s flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-4 py-2 text-xs font-medium text-stone-300 backdrop-blur-md transition-all hover:border-accent/50 hover:bg-accent/10 hover:text-accent'>
                        <SocialIcon name={s.key} />
                        <span>{s.label}</span>
                      </a>
                    ))}
                  </div>
                </div>
              )
            }
          </div>
        </div>
      </article>
    </div>

    {/* Faculty */}
    <div class='relative z-10 mx-auto mt-24 w-full max-w-[1400px] px-6 md:px-10'>
      <div class='mb-8 flex items-center gap-3 text-[10px] tracking-[0.3em] uppercase text-stone-500'>
        <span class='h-px w-8 bg-accent'></span>
        <span class='text-accent'>02</span>
        <span>·</span>
        <span>CEITE Faculty</span>
        <span class='ml-auto tabular-nums text-stone-400'>{pad(faculty.length)} Members</span>
      </div>

      <div class='grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4'>
        {
          faculty.map((f, i) => {
            const socials = socialLinks(f.data);
            return (
              <article class='staff-card group relative flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-white/[0.02] backdrop-blur-md transition-all duration-500 hover:border-accent/30 hover:bg-white/[0.04]'>
                {/* Portrait */}
                <div class='relative aspect-[4/5] overflow-hidden'>
                  <SanityImage
                    image={f.data?.image}
                    fallback={`/images/default_avatar.svg`}
                    width={512}
                    height={640}
                    class='size-full object-cover saturate-[0.85] transition-all duration-700 group-hover:scale-102 group-hover:saturate-100'
                  />
                  <div class='absolute inset-0 bg-linear-to-t from-background via-background/40 via-30% to-transparent' />

                  {/* Name overlay */}
                  <div class='absolute inset-x-0 bottom-0 p-5'>
                    <h3 class='text-lg font-bold leading-tight text-stone-50 sm:text-xl'>{fullName(f.data)}</h3>
                  </div>
                </div>

                {/* Card body */}
                <div class='flex flex-col gap-3 p-4'>
                  {/* Title */}
                  {f.data?.title && (
                    <div class='flex flex-col gap-1'>
                      <span class='text-sm font-medium text-accent leading-snug'>{f.data.title}</span>
                    </div>
                  )}

                  {/* Email — visible, dedicated row */}
                  {f.data?.email && (
                    <a
                      href={`mailto:${f.data.email}`}
                      class='group/email flex items-center gap-2 rounded-xl border border-white/5 bg-white/[0.02] px-3 py-2 text-xs text-stone-300 transition-all hover:border-accent/40 hover:bg-accent/10 hover:text-accent'>
                      <span class='shrink-0 text-stone-400 group-hover/email:text-accent'>
                        <SocialIcon name='email' />
                      </span>
                      <span class='break-all font-medium leading-snug'>{f.data.email}</span>
                    </a>
                  )}

                  {/* Social icons row */}
                  {socials.length > 0 && (
                    <div class='flex items-center gap-1.5 border-t border-white/5 pt-3'>
                      {socials.map((soc) => (
                        <a
                          href={soc.href}
                          target='_blank'
                          rel='noopener noreferrer'
                          aria-label={soc.label}
                          title={soc.label}
                          class='flex size-9 items-center justify-center rounded-full border border-white/5 bg-white/[0.02] text-stone-400 transition-all hover:border-accent/50 hover:bg-accent/10 hover:text-accent'>
                          <SocialIcon name={soc.key} />
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</MainLayout>
