    `;

    function initArticleGallery() {
      const lightbox = new PhotoSwipeLightbox({
        gallery: '#news-article-gallery',
        children: 'a.pswp-link',
        showHideAnimationType: 'zoom',
        showAnimationDuration: 0,
        hideAnimationDuration: 250,
        clickToCloseNonZoomable: true,
        errorMsg: 'The photo cannot be loaded',
        pinchToClose: true,
        pswpModule: () => import('photoswipe'),
      });

      lightbox.on('uiRegister', () => {
        lightbox.pswp?.ui?.registerElement({
          name: 'swipe-hint',
          order: 6,
          isButton: false,
          appendTo: 'wrapper',
          html: `<span class="pswp__swipe-hint">Swipe ${UpDownGestureIcon} or Pinch ${PinchGestureIcon} to exit</span>`,
        });
      });

      lightbox.init();
    }

    // Run initialization
    initArticleGallery();
    document.addEventListener('astro:after-swap', initArticleGallery);
  </script>
</MainLayout>
