---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import SanityImage from '../../components/SanityImage.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { PortableText } from 'astro-portabletext';
import SanityPortableImage from '../../components/SanityPortableImage.astro';
import SanityHighlight from '../../components/SanityHighlight.astro';

const components = {
  type: {
    image: SanityPortableImage,
  },
  marks: {
    highlight: SanityHighlight,
  },
};

export const getStaticPaths = (async () => {
  const sanityNews = await getCollection('news');

  return sanityNews.map((news) => ({
    params: {
      slug: news.data.slug,
    },
    props: {
      news,
    },
  }));
}) satisfies GetStaticPaths;

const { news } = Astro.props;

function formatDate(date: Date | string) {
  return new Date(date).toLocaleDateString('en-US', {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

function formatDateShort(date: Date | string) {
  return new Date(date).toLocaleDateString('en-US', {
    month: 'short',
    day: '2-digit',
    year: 'numeric',
  });
}

// Estimate reading time from portable text
function estimateReadTime(body: any[]): number {
  if (!body) return 1;
  const text = body
    .filter((b) => b._type === 'block')
    .flatMap((b) => b.children?.map((c: any) => c.text) ?? [])
    .join(' ');
  const words = text.split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 200));
}

const readTime = estimateReadTime(news.data.body);
const createdDate = new Date(news.data._createdAt);

const featuredWidth = news.data?.image?.asset?.metadata?.dimensions?.width || 1024;
const featuredHeight = news.data?.image?.asset?.metadata?.dimensions?.height || 1024;
const featuredFullUrl = news.data?.image?.asset?.url || '/images/default_background.avif';
---

<MainLayout>
  <article id='news-article-gallery' class='relative w-full bg-background pb-24 pt-28 md:pt-32'>
    {/* ─── Breadcrumb / meta bar ─── */}
    <div
      class='mx-auto mb-10 flex w-full max-w-[1100px] items-center gap-4 px-6 md:px-10 text-[10px] md:text-xs tracking-[0.25em] text-stone-500'>
      <a href='/news' class='flex items-center gap-2 text-stone-300 transition-colors hover:text-accent'>
        <svg
          class='size-3'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'>
          <path d='M19 12H5M12 19l-7-7 7-7'></path>
        </svg>
        <span class='uppercase'>Happenings</span>
      </a>
      <span class='h-px flex-1 bg-linear-to-r from-stone-700/80 via-stone-700/30 to-transparent'></span>
      <span class='uppercase tabular-nums'>{formatDateShort(news.data._createdAt)}</span>
    </div>

    {/* ─── Header ─── */}
    <header class='mx-auto mb-10 w-full max-w-[900px] px-6 md:px-10'>
      {
        news.data.category && (
          <div class='mb-6 flex items-center gap-3'>
            <span class='h-px w-8 bg-accent' />
            <span class='text-[10px] tracking-[0.3em] uppercase text-accent font-bold'>{news.data.category}</span>
          </div>
        )
      }
      <h1 class='font-extrabold text-4xl leading-[1.1] text-stone-50 sm:text-5xl md:text-6xl'>
        {news.data.title}
      </h1>
      <div
        class='mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-stone-700/50 pt-6 text-xs text-stone-400'>
        <div class='flex items-center gap-2'>
          <svg
            class='size-3.5 text-stone-500'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
            aria-hidden='true'>
            <rect x='3' y='4' width='18' height='18' rx='2'></rect>
            <path d='M16 2v4M8 2v4M3 10h18'></path>
          </svg>
          <time datetime={createdDate.toISOString()} class='tracking-wide'>{formatDate(news.data._createdAt)}</time>
        </div>
        <span class='size-1 rounded-full bg-stone-700'></span>
        <div class='flex items-center gap-2'>
          <svg
            class='size-3.5 text-stone-500'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
            aria-hidden='true'>
            <circle cx='12' cy='12' r='10'></circle>
            <path d='M12 6v6l4 2'></path>
          </svg>
          <span class='tabular-nums'>{readTime} min read</span>
        </div>
      </div>
    </header>

    {/* ─── Featured image ─── */}
    <figure class='mx-auto mb-12 w-full max-w-[1100px] px-6 md:px-10'>
      <div class='overflow-hidden rounded-2xl border border-white/10 bg-white/[0.02]'>
        <a
          href={featuredFullUrl}
          data-pswp-width={featuredWidth}
          data-pswp-height={featuredHeight}
          class='pswp-link block w-full cursor-zoom-in'>
          <SanityImage
            width={1024}
            height={576}
            class='w-full max-h-[640px] object-cover'
            image={news.data.image}
            fallback='/images/default_background.avif'
          />
        </a>
      </div>
    </figure>

    {/* ─── Body ─── */}
    <div class='mx-auto w-full max-w-[760px] px-6 md:px-10'>
      <div class='portable-text portable-text-article'>
        <PortableText value={news.data?.body} components={components} />
      </div>

      {/* ─── End-of-article footer ─── */}
      <div class='mt-16 border-t border-stone-700/50 pt-8'>
        <div class='flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between'>
          <div class='flex flex-col gap-1'>
            <span class='text-[10px] tracking-[0.3em] uppercase text-stone-500'>End of article</span>
          </div>
          <a
            href='/news'
            class='inline-flex w-fit items-center gap-2 rounded-full border border-accent/40 bg-accent/10 px-5 py-2.5 text-xs font-semibold tracking-[0.2em] uppercase text-accent transition-colors hover:border-accent hover:bg-accent hover:text-background'>
            <svg
              class='size-3.5'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'>
              <path d='M19 12H5M12 19l-7-7 7-7'></path>
            </svg>
            <span>Go Back</span>
          </a>
        </div>
      </div>
    </div>
  </article>

  <link rel='stylesheet' href='photoswipe/dist/photoswipe.css' />

  <script>
    import PhotoSwipeLightbox from 'photoswipe/lightbox';

    const UpDownGestureIcon = `
    <svg class='inline-block w-6 h-6 text-accent' width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path fill="none" stroke="currentColor" stroke-miterlimit="10" stroke-width="1.91"
        d="M13,22.5,7.82,17.36a2,2,0,0,1-.59-1.43,2,2,0,0,1,2-2,2,2,0,0,1,1.43.59L12,15.82V6.38a2,2,0,0,1,1.74-2,1.87,1.87,0,0,1,1.51.56,1.83,1.83,0,0,1,.57,1.34V12l5,.72a1.91,1.91,0,0,1,1.64,1.89h0a17.18,17.18,0,0,1-1.82,7.71l-.09.18"/>
      <polyline fill="none" stroke="currentColor" stroke-width="1.91" points="7.23 11.04 4.36 13.91 1.5 11.04"/>
      <line fill="none" stroke="currentColor" stroke-width="1.91" x1="4.36" y1="6.27" x2="4.36" y2="13.91"/>
      <polyline fill="none" stroke="currentColor" stroke-width="1.91" points="5.32 4.36 8.18 1.5 11.04 4.36"/>
      <line fill="none" stroke="currentColor" stroke-width="1.91" x1="8.18" y1="9.14" x2="8.18" y2="1.5"/>
    </svg>
    `;

    const PinchGestureIcon = `
      <?xml version="1.0" encoding="utf-8"?><!-- Uploaded to: SVG Repo, www.svgrepo.com, Generator: SVG Repo Mixer Tools -->
<svg class='inline-block w-6 h-6 text-accent' fill="currentColor" width="800px" height="800px" viewBox="0 0 14 14" role="img" focusable="false" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><path d="m 8.12441,12.961763 c -0.0211,-0.021 -0.0384,-0.094 -0.0384,-0.1624 0,-0.068 -0.0434,-0.2515 -0.0964,-0.4071 -0.077,-0.2259 -0.21506,-0.3995 -0.68378,-0.8595 -0.58327,-0.5724 -0.59061,-0.583 -1.05909,-1.5381005 -0.51694,-1.0539 -0.77974,-1.4893 -1.21313,-2.0101 -0.30495,-0.3664 -0.39636,-0.5878 -0.3039,-0.736 0.15376,-0.2464 0.63155,-0.3074 0.98383,-0.1255 0.29042,0.1499 0.59998,0.4813 0.95366,1.021 0.30722,0.4687 0.46244,0.5704 0.59465,0.3896 0.10339,-0.1414 0.10144,-1.868 -0.002,-2.1542 -0.0402,-0.1108 -0.28129,-0.4735 -0.53568,-0.806 -0.60145,-0.786 -0.61847,-0.8198 -0.53691,-1.0669 0.0879,-0.2664 0.30798,-0.4299 0.57865,-0.4299 0.20886,0 0.2466,0.033 0.87019,0.7614 0.35853,0.4188 0.69721,0.8139 0.75262,0.878 0.0923,0.1067 0.10564,0.1084 0.15866,0.02 0.0809,-0.1345 0.36486,-0.1842 0.60305,-0.1056 0.29471,0.097 0.43288,0.304 0.43288,0.6478 l 0,0.2864 0.11005,-0.1359 c 0.09,-0.1111 0.16436,-0.1359 0.40772,-0.1359 0.26345,0 0.31698,0.022 0.46566,0.188 0.11749,0.1315 0.16799,0.2483 0.16799,0.3886 l 0,0.2006 0.11514,-0.1151 c 0.23367,-0.2337 0.75236,-0.085 0.89513,0.2568 0.0616,0.1475 0.0815,0.5788 0.0863,1.8736 l 0.006,1.6819005 -0.31641,0.6413 c -0.30365,0.6155 -0.44087,1.0579 -0.44087,1.4214 l 0,0.1699 -1.45846,0 c -0.80216,0 -1.47574,-0.017 -1.49685,-0.038 z m -5.80662,-1.9355 -0.15509,-0.1274 0.46443,-0.6299 0.46444,-0.6299005 -0.13146,-0.1064 c -0.0723,-0.059 -0.17243,-0.1294 -0.22251,-0.1574 -0.0501,-0.028 -0.0783,-0.062 -0.0627,-0.076 0.0156,-0.014 0.36123,-0.1941 0.76813,-0.4004 0.72356,-0.3667 0.73918,-0.3716 0.71029,-0.2236 -0.0163,0.083 -0.0754,0.4492 -0.13147,0.8134 -0.056,0.3641 -0.10943,0.6721005 -0.11861,0.6844005 -0.009,0.012 -0.10753,-0.047 -0.21854,-0.1315 L 3.48286,9.8876625 3.01619,10.522863 c -0.25667,0.3494 -0.4839,0.6344 -0.50497,0.6332 -0.0