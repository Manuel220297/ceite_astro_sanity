---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import SanityImage from '../../components/SanityImage.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { PortableText } from 'astro-portabletext';
import SanityPortableImage from '../../components/SanityPortableImage.astro';
import SanityHighlight from '../../components/SanityHighlight.astro';
const components = {
  type: {
    image: SanityPortableImage,
  },
  marks: {
    highlight: SanityHighlight,
  },
};

export const getStaticPaths = (async () => {
  const sanityNews = await getCollection('sanityNews');

  return sanityNews.map((news) => ({
    params: {
      slug: news.data.slug,
    },
    props: {
      news,
    },
  }));
}) satisfies GetStaticPaths;

const { news } = Astro.props;
---

<MainLayout>
  <div>
    <h1>News slug</h1>
    <SanityImage class='max-h-[720px] rounded-md' image={news.data.image} />
    <h2 class='text-blue-300'>{news.data.title}</h2>
    <p>{news.data._createdAt.toLocaleString()}</p>
    <PortableText value={news.data?.body} />
  </div>
</MainLayout>
