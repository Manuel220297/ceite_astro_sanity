---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import SanityImage from '../../components/SanityImage.astro';
import ProgramOverview from '../../components/programs-page/ProgramOverview.astro';
import ProgramHeader from '../../components/programs-page/ProgramHeader.astro';
import ProgramCurriculum from '../../components/programs-page/ProgramCurriculum.astro';
import ProgramGallery from '@/components/programs-page/ProgramGallery.astro';

export async function getStaticPaths() {
  const programs = await getCollection('programs');

  return programs.map((p) => ({
    params: {
      slug: p.data.slug,
    },
    props: {
      program: p,
    },
  }));
}

const { program } = Astro.props;

const allProjects = await getCollection('projects');

const projects = allProjects.filter((p) => p.data.program?.slug === program.data.slug);
---

<MainLayout>
  <ProgramHeader program={program} />
  <ProgramOverview program={program} />
  <ProgramCurriculum program={program} />
  <ProgramGallery program={program} />
  <article id='program-projects'>
    <h2>{program.data.title} STUDENT PROJECTS</h2>
    {
      projects.map((project) => (
        <div>
          <SanityImage width={128} height={128} image={project.data.image} />
          <p>{project.data.title}</p>
          <div set:html={project.data.body} />
        </div>
      ))
    }
  </article>
</MainLayout>
